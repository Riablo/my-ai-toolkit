#!/usr/bin/env bash
set -euo pipefail

SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  SELF_DIR="$(cd "$(dirname "$SELF")" && pwd)"
  SELF="$(readlink "$SELF")"
  [[ "$SELF" != /* ]] && SELF="$SELF_DIR/$SELF"
done

SCRIPT_DIR="$(cd "$(dirname "$SELF")" && pwd)"

if ! command -v node >/dev/null 2>&1; then
  echo "错误：未找到 node，请先安装 Node.js 18+。" >&2
  exit 1
fi

exec node -e '
  if (Number(process.versions.node.split(".")[0]) < 18) {
    console.error("错误：cloudsaver-cli 需要 Node.js 18+，当前版本为 " + process.version + "。");
    process.exit(1);
  }
  require(process.argv[1]);
' "$SCRIPT_DIR/cloudsaver-cli.cjs" "$@"
