#compdef myskills

__myskills_skills() {
  local -a skills
  skills=("${(@f)$(myskills list --names 2>/dev/null)}")
  skills=("${skills[@]//:/\\:}")
  _describe -t skills 'skill' skills
}

_myskills() {
  local -a commands target_options
  commands=(
    'list:列出所有可用的 skills'
    'link:将 skill 软链接到目标目录'
    'install:将 skill 复制到目标目录并覆盖已有内容'
    'unlink:移除 skill 的所有软链接'
    'uninstall:移除通过 install 复制的 skill 目录'
    'status:查看所有 skills 的状态'
  )
  target_options=(
    '--agents[~/.agents/skills/]'
    '--claude[~/.claude/skills/]'
    '--local-agents[./.agents/skills/]'
    '--local-claude[./.claude/skills/]'
  )

  if (( CURRENT == 2 )); then
    if [[ "$PREFIX" == -* ]]; then
      _arguments '(-h --help)'{-h,--help}'[显示帮助信息]'
    else
      _describe -t commands 'command' commands
    fi
    return
  fi

  case "$words[2]" in
    link|install|unlink|uninstall)
      if (( CURRENT == 3 )) && [[ "$PREFIX" != -* ]]; then
        __myskills_skills
      elif (( CURRENT > 3 )); then
        _arguments $target_options '(-h --help)'{-h,--help}'[显示帮助信息]'
      else
        _arguments '(-h --help)'{-h,--help}'[显示帮助信息]'
      fi
      ;;
    list)
      _arguments '--names[仅输出 skill 名称，每行一个]' '(-h --help)'{-h,--help}'[显示帮助信息]'
      ;;
    status)
      _arguments '(-h --help)'{-h,--help}'[显示帮助信息]'
      ;;
  esac
}

_myskills "$@"
