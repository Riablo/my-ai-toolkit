#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
控制 Skill 是否允许模型自动调用

用法:
  skill-auto on <skill 目录>
  skill-auto off <skill 目录>
  skill-auto -h | --help

说明:
  on   开启自动调用与 discovery context 注入
  off  关闭自动调用与 discovery context 注入，仍可显式调用

命令会同步维护两种配置：
  SKILL.md              disable-model-invocation
  agents/openai.yaml    policy.allow_implicit_invocation

示例:
  skill-auto on ./skills/my-skill
  skill-auto off ~/.agents/skills/my-skill
EOF
}

die() {
  printf '错误：%s\n' "$1" >&2
  exit 1
}

cleanup_files=()

cleanup() {
  local file
  for file in "${cleanup_files[@]}"; do
    [ ! -e "$file" ] || rm -f "$file"
  done
}

trap cleanup EXIT

make_temp_for() {
  local target="$1"
  local target_dir
  target_dir="$(dirname "$target")"
  mktemp "$target_dir/.skill-auto.XXXXXX"
}

validate_skill_md() {
  local file="$1"

  awk '
    NR == 1 && $0 == "---" { in_frontmatter = 1; next }
    in_frontmatter && $0 == "---" { closed = 1; exit }
    in_frontmatter && $0 ~ /^disable-model-invocation[[:space:]]*:/ { count++ }
    END {
      if (!in_frontmatter || !closed) exit 2
      if (count > 1) exit 3
    }
  ' "$file"
}

render_skill_md() {
  local file="$1"
  local value="$2"
  local output="$3"

  awk -v value="$value" '
    NR == 1 && $0 == "---" {
      in_frontmatter = 1
      print
      next
    }
    in_frontmatter && $0 == "---" {
      if (!updated) print "disable-model-invocation: " value
      in_frontmatter = 0
      print
      next
    }
    in_frontmatter && $0 ~ /^disable-model-invocation[[:space:]]*:/ {
      match($0, /[[:space:]]+#.*/)
      comment = RSTART ? substr($0, RSTART) : ""
      print "disable-model-invocation: " value comment
      updated = 1
      next
    }
    { print }
  ' "$file" > "$output"
}

validate_openai_yaml() {
  local file="$1"

  [ ! -f "$file" ] && return 0

  awk '
    function is_top_level(line) {
      return line ~ /^[^[:space:]#][^:]*:/
    }
    {
      if (in_policy && is_top_level($0)) in_policy = 0

      if ($0 ~ /^policy:[[:space:]]*([^#[:space:]].*)?$/ && $0 !~ /^policy:[[:space:]]*(#.*)?$/) {
        inline_policy = 1
      }
      if ($0 ~ /^policy:[[:space:]]*(#.*)?$/) {
        policy_count++
        in_policy = 1
      }

      if ($0 ~ /^[[:space:]]+allow_implicit_invocation[[:space:]]*:/) {
        key_count++
        if (!in_policy) misplaced_key = 1
      }
    }
    END {
      if (inline_policy) exit 2
      if (policy_count > 1 || key_count > 1) exit 3
      if (misplaced_key) exit 4
    }
  ' "$file"
}

render_openai_yaml() {
  local file="$1"
  local value="$2"
  local output="$3"

  if [ ! -f "$file" ]; then
    printf 'policy:\n  allow_implicit_invocation: %s\n' "$value" > "$output"
    return
  fi

  awk -v value="$value" '
    function is_top_level(line) {
      return line ~ /^[^[:space:]#][^:]*:/
    }
    function flush_policy_key() {
      if (in_policy && !key_updated) {
        print "  allow_implicit_invocation: " value
        key_updated = 1
      }
    }
    {
      if (in_policy && is_top_level($0)) {
        flush_policy_key()
        in_policy = 0
      }

      if ($0 ~ /^policy:[[:space:]]*(#.*)?$/) {
        policy_found = 1
        in_policy = 1
        print
        next
      }

      if (in_policy && $0 ~ /^[[:space:]]+allow_implicit_invocation[[:space:]]*:/) {
        match($0, /^[[:space:]]*/)
        indent = substr($0, 1, RLENGTH)
        match($0, /[[:space:]]+#.*/)
        comment = RSTART ? substr($0, RSTART) : ""
        print indent "allow_implicit_invocation: " value comment
        key_updated = 1
        next
      }

      print
    }
    END {
      flush_policy_key()
      if (!policy_found) {
        if (NR > 0) print ""
        print "policy:"
        print "  allow_implicit_invocation: " value
      }
    }
  ' "$file" > "$output"
}

[ "$#" -gt 0 ] || {
  usage >&2
  exit 1
}

case "$1" in
  -h|--help)
    [ "$#" -eq 1 ] || die "--help 不接受其他参数"
    usage
    exit 0
    ;;
  on|off)
    action="$1"
    ;;
  *)
    die "未知命令 '$1'。只能使用 on 或 off。"
    ;;
esac

[ "$#" -eq 2 ] || die "用法：skill-auto $action <skill 目录>"

skill_dir="${2%/}"
[ -n "$skill_dir" ] || skill_dir="/"
[ -d "$skill_dir" ] || die "目录不存在：$skill_dir"

skill_md="$skill_dir/SKILL.md"
openai_yaml="$skill_dir/agents/openai.yaml"
[ -f "$skill_md" ] || die "目录中缺少 SKILL.md：$skill_dir"

if validate_skill_md "$skill_md"; then
  :
else
  validation_status="$?"
  if [ "$validation_status" -eq 3 ]; then
    die "SKILL.md 中存在多个 disable-model-invocation，未修改文件"
  fi
  die "SKILL.md 缺少有效的 YAML frontmatter，未修改文件"
fi

if validate_openai_yaml "$openai_yaml"; then
  :
else
  validation_status="$?"
  case "$validation_status" in
    2) die "agents/openai.yaml 使用了内联 policy，无法安全修改" ;;
    3) die "agents/openai.yaml 中存在重复的 policy 或 allow_implicit_invocation" ;;
    *) die "agents/openai.yaml 中的 allow_implicit_invocation 不在 policy 下" ;;
  esac
fi

if [ "$action" = "on" ]; then
  disable_value="false"
  implicit_value="true"
  state_label="已开启"
else
  disable_value="true"
  implicit_value="false"
  state_label="已关闭"
fi

skill_tmp="$(make_temp_for "$skill_md")"
cleanup_files+=("$skill_tmp")
render_skill_md "$skill_md" "$disable_value" "$skill_tmp"

mkdir -p "$(dirname "$openai_yaml")"
openai_tmp="$(make_temp_for "$openai_yaml")"
cleanup_files+=("$openai_tmp")
render_openai_yaml "$openai_yaml" "$implicit_value" "$openai_tmp"

chmod --reference="$skill_md" "$skill_tmp" 2>/dev/null || chmod "$(stat -f '%Lp' "$skill_md")" "$skill_tmp"
if [ -f "$openai_yaml" ]; then
  chmod --reference="$openai_yaml" "$openai_tmp" 2>/dev/null || chmod "$(stat -f '%Lp' "$openai_yaml")" "$openai_tmp"
else
  chmod 0644 "$openai_tmp"
fi

mv "$skill_tmp" "$skill_md"
mv "$openai_tmp" "$openai_yaml"
cleanup_files=()

printf 'Skill 自动调用%s：%s\n' "$state_label" "$skill_dir"
printf '  SKILL.md: disable-model-invocation: %s\n' "$disable_value"
printf '  agents/openai.yaml: policy.allow_implicit_invocation: %s\n' "$implicit_value"
