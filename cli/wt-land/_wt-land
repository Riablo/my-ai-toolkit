#compdef wt-land

_wt-land() {
  if (( CURRENT == 2 )); then
    local current_ref line worktree branch
    local -a targets

    current_ref="$(git symbolic-ref --quiet HEAD 2>/dev/null)" || return 1

    while IFS= read -r -d '' line; do
      if [[ "$line" == worktree\ * ]]; then
        worktree="${line#worktree }"
      elif [[ "$line" == branch\ refs/heads/* && "$line" != "branch $current_ref" ]]; then
        branch="${line#branch refs/heads/}"
        targets+=("$branch:$worktree")
      fi
    done < <(git worktree list --porcelain -z 2>/dev/null)

    _describe '目标 worktree 分支' targets
    return
  fi

  _arguments '(-h --help)'{-h,--help}'[显示帮助]'
}

_wt-land "$@"
