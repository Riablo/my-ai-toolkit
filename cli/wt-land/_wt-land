#compdef wt-land

_wt-land() {
  if (( CURRENT == 2 )); then
    local current_ref ref worktree
    local -a targets

    current_ref="$(git symbolic-ref --quiet HEAD 2>/dev/null)" || return 1

    while IFS=$'\t' read -r ref worktree; do
      [[ "$ref" == "$current_ref" ]] && continue
      targets+=("${ref#refs/heads/}:${worktree:-本地分支}")
    done < <(git for-each-ref --format='%(refname)%09%(worktreepath)' refs/heads/ 2>/dev/null)

    _describe '本地目标分支' targets
    return
  fi

  _arguments '(-h --help)'{-h,--help}'[显示帮助]'
}

_wt-land "$@"
