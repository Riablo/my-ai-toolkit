#compdef jenkins-builder-cli

_jenkins-builder-cli() {
  local -a commands config_commands jobs_commands runs_commands labels
  commands=(
    'config:管理本地配置'
    'doctor:检查配置和连接并同步 jobs'
    'jobs:列出和管理 jobs'
    'build:触发构建'
    'set-branch:修改分支配置'
    'runs:查看运行中的构建'
    'logs:查看 console output'
  )
  config_commands=(
    'init:初始化 Jenkins 配置'
    'show:查看配置'
    'path:显示配置文件路径'
  )
  jobs_commands=(
    'list:列出可构建 jobs'
    'label:标注 job 为测试服或正式服'
    'unlabel:移除 job 标签'
    'desc:设置 job 描述（空字符串清除）'
  )
  runs_commands=(
    'list:列出运行中的构建'
    'status:查询某次构建的状态'
    'stop:停止运行中的构建'
  )
  labels=(test prod)

  if (( CURRENT == 2 )); then
    if [[ "$PREFIX" == -* ]]; then
      _arguments '(-h --help)'{-h,--help}'[显示帮助信息]'
    else
      _describe -t commands 'command' commands
    fi
    return
  fi

  local command="$words[2]" subcommand="$words[3]"
  # _arguments treats words[1] as the command; remove each parent command.
  shift words
  (( CURRENT-- ))
  if [[ "$command" == (config|runs) ]] && (( CURRENT > 2 )); then
    shift words
    (( CURRENT-- ))
  elif [[ "$command" == jobs && "$subcommand" == (list|label|unlabel|desc) ]] && (( CURRENT > 2 )); then
    shift words
    (( CURRENT-- ))
  fi

  case "$command" in
    doctor)
      _arguments '--json[输出 JSON]'
      ;;
    config)
      case "$subcommand" in
        init)
          _arguments \
            '--url[Jenkins URL]:url:_urls' \
            '--username[用户名]:username:' \
            '--token[API token]:token:' \
            '--verify-ssl[是否校验证书]:verify ssl:(true false)'
          ;;
        show)
          _arguments '--json[输出 JSON]'
          ;;
        *)
          if (( CURRENT == 2 )); then
            _describe -t config-commands 'config command' config_commands
          fi
          ;;
      esac
      ;;
    jobs)
      case "$subcommand" in
        list)
          _arguments \
            '--query[按名称/标签/描述过滤]:query:' \
            '--json[输出 JSON]'
          ;;
        label)
          _arguments \
            '--json[输出 JSON]' \
            '1:job name:' \
            '2:label:($labels)'
          ;;
        unlabel)
          _arguments \
            '--json[输出 JSON]' \
            '1:job name:'
          ;;
        desc)
          _arguments \
            '--json[输出 JSON]' \
            '1:job name:' \
            '2:description:'
          ;;
        *)
          if [[ "$PREFIX" == -* ]]; then
            _arguments \
              '--query[按名称/标签/描述过滤]:query:' \
              '--json[输出 JSON]'
          elif (( CURRENT == 2 )); then
            _describe -t jobs-commands 'jobs command' jobs_commands
          fi
          ;;
      esac
      ;;
    build)
      _arguments \
        '--follow[等待构建完成]' \
        '--json[输出 JSON]' \
        '--job[完整 Jenkins job 名称]:job name:' \
        '--branch[先持久修改分支再构建]:branch:'
      ;;
    set-branch)
      _arguments \
        '--json[输出 JSON]' \
        '--job[完整 Jenkins job 名称]:job name:' \
        '--branch[目标分支名称]:branch:'
      ;;
    runs)
      case "$subcommand" in
        list)
          _arguments '--json[输出 JSON]'
          ;;
        status|stop)
          _arguments \
            '--json[输出 JSON]' \
            '1:run id:'
          ;;
        *)
          if (( CURRENT == 2 )); then
            _describe -t runs-commands 'runs command' runs_commands
          fi
          ;;
      esac
      ;;
    logs)
      _arguments \
        '--tail[仅展示最后 N 行]:lines:' \
        '--follow[持续输出直到结束]' \
        '--json[输出 JSON]' \
        '1:run id:'
      ;;
  esac
}

_jenkins-builder-cli "$@"
