#!/usr/bin/env bash
set -euo pipefail

API_BASE="https://open.pingcode.com"
CONFIG_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/pingcode-cli"
CONFIG_FILE="${CONFIG_DIR}/config.json"

die() {
  printf '错误：%s\n' "$1" >&2
  exit 1
}

need_arg() {
  [ "$#" -ge 2 ] && [ -n "$2" ] || die "$1 需要参数"
}

require_commands() {
  local command
  for command in curl jq; do
    command -v "$command" >/dev/null 2>&1 || die "缺少依赖：${command}"
  done
}

validate_timestamp() {
  [[ "$1" =~ ^[0-9]+$ ]] || die "时间戳必须是 Unix 秒数：$1"
}

validate_config() {
  [ -f "$CONFIG_FILE" ] || die "尚未初始化。请先运行 pingcode-cli init"
  jq -e 'type == "object"' "$CONFIG_FILE" >/dev/null 2>&1 ||
    die "配置文件不是有效的 JSON：${CONFIG_FILE}"

  local key missing=()
  for key in client_id client_secret my_assignee_id; do
    jq -e --arg key "$key" '(.[$key] | type == "string" and length > 0)' "$CONFIG_FILE" >/dev/null 2>&1 ||
      missing+=("$key")
  done
  [ "${#missing[@]}" -eq 0 ] ||
    die "配置缺少必要字段：${missing[*]}。请补全 ${CONFIG_FILE}，或重新运行 pingcode-cli init"

  jq -e '
    (.created_after == null) or
    ((.created_after | type) == "number" and .created_after >= 0 and .created_after == (.created_after | floor))
  ' "$CONFIG_FILE" >/dev/null 2>&1 || die "配置字段 created_after 必须是 null 或 Unix 秒数"
  jq -e '(.projects // [] | type == "array")' "$CONFIG_FILE" >/dev/null 2>&1 ||
    die "配置字段 projects 必须是数组"
}

write_config() {
  local filter="$1"
  shift
  local tmp
  tmp="$(mktemp "${CONFIG_DIR}/config.XXXXXX")"
  jq "$@" "$filter" "$CONFIG_FILE" > "$tmp"
  chmod 600 "$tmp"
  mv -f "$tmp" "$CONFIG_FILE"
}

cmd_init() {
  [ "$#" -eq 0 ] || die "init 不接受参数"
  local client_id client_secret my_assignee_id set_created_after created_after=""
  IFS= read -r -p 'client_id: ' client_id
  IFS= read -r -s -p 'client_secret: ' client_secret
  printf '\n' >&2
  IFS= read -r -p 'my_assignee_id: ' my_assignee_id
  [ -n "$client_id" ] || die "client_id 不能为空"
  [ -n "$client_secret" ] || die "client_secret 不能为空"
  [ -n "$my_assignee_id" ] || die "my_assignee_id 不能为空"
  IFS= read -r -p '是否设置全局 created_at 起点？[y/N]: ' set_created_after
  case "$set_created_after" in
    y|Y|yes|YES|是)
      IFS= read -r -p 'created_after（Unix 秒数）: ' created_after
      validate_timestamp "$created_after"
      ;;
  esac

  mkdir -p "$CONFIG_DIR"
  local tmp
  tmp="$(mktemp "${CONFIG_DIR}/config.XXXXXX")"
  jq -n \
    --arg client_id "$client_id" \
    --arg client_secret "$client_secret" \
    --arg my_assignee_id "$my_assignee_id" \
    --arg created_after "$created_after" '
      {
        client_id: $client_id,
        client_secret: $client_secret,
        my_assignee_id: $my_assignee_id,
        created_after: (if $created_after == "" then null else ($created_after | tonumber) end),
        access_token: null,
        refresh_token: null,
        expires_in: null,
        token_obtained_at: null,
        projects: [],
        projects_refreshed_at: null
      }
    ' > "$tmp"
  chmod 600 "$tmp"
  mv -f "$tmp" "$CONFIG_FILE"
  printf '配置已保存到 %s\n' "$CONFIG_FILE" >&2
}

HTTP_STATUS=""
HTTP_BODY=""

http_request() {
  local method="$1" url="$2"
  shift 2
  local raw
  raw="$(curl --silent --show-error --location \
    --connect-timeout 10 --max-time 60 \
    --request "$method" --write-out $'\n%{http_code}' \
    "$url" "$@")" || die "网络请求失败：${url}"
  HTTP_STATUS="${raw##*$'\n'}"
  HTTP_BODY="${raw%$'\n'*}"
  [[ "$HTTP_STATUS" =~ ^[0-9]{3}$ ]] || die "无法读取 HTTP 状态码"
}

save_tokens() {
  local response="$1" fallback_refresh="${2:-}"
  jq -e '
    (.access_token | type == "string" and length > 0) and
    ((.expires_in | type) == "number" and .expires_in > 0 and .expires_in == (.expires_in | floor))
  ' <<< "$response" >/dev/null 2>&1 || return 1

  local access_token refresh_token expires_in obtained_at
  access_token="$(jq -r '.access_token' <<< "$response")"
  refresh_token="$(jq -r '.refresh_token // empty' <<< "$response")"
  refresh_token="${refresh_token:-$fallback_refresh}"
  [ -n "$refresh_token" ] || return 1
  expires_in="$(jq -r '.expires_in' <<< "$response")"
  obtained_at="$(date +%s)"

  write_config '
    .access_token = $access_token |
    .refresh_token = $refresh_token |
    .expires_in = $expires_in |
    .token_obtained_at = $obtained_at
  ' --arg access_token "$access_token" \
    --arg refresh_token "$refresh_token" \
    --argjson expires_in "$expires_in" \
    --argjson obtained_at "$obtained_at"
}

request_tokens() {
  local grant_type="$1" value="$2" fallback_refresh="${3:-}"
  local client_id client_secret
  client_id="$(jq -r '.client_id' "$CONFIG_FILE")"
  client_secret="$(jq -r '.client_secret' "$CONFIG_FILE")"

  if [ "$grant_type" = "authorization_code" ]; then
    http_request GET "${API_BASE}/v1/auth/token" --get \
      --data-urlencode 'grant_type=authorization_code' \
      --data-urlencode "client_id=${client_id}" \
      --data-urlencode "client_secret=${client_secret}" \
      --data-urlencode "code=${value}"
  else
    http_request GET "${API_BASE}/v1/auth/token" --get \
      --data-urlencode 'grant_type=refresh_token' \
      --data-urlencode "refresh_token=${value}"
  fi

  [ "$HTTP_STATUS" -ge 200 ] && [ "$HTTP_STATUS" -lt 300 ] || return 1
  save_tokens "$HTTP_BODY" "$fallback_refresh"
}

clear_tokens() {
  write_config '
    .access_token = null |
    .refresh_token = null |
    .expires_in = null |
    .token_obtained_at = null
  '
}

token_is_valid() {
  local access_token expires_in obtained_at now
  access_token="$(jq -r '.access_token // empty' "$CONFIG_FILE")"
  expires_in="$(jq -r '.expires_in // 0' "$CONFIG_FILE")"
  obtained_at="$(jq -r '.token_obtained_at // 0' "$CONFIG_FILE")"
  [[ "$expires_in" =~ ^[0-9]+$ && "$obtained_at" =~ ^[0-9]+$ ]] || return 1
  now="$(date +%s)"
  [ -n "$access_token" ] && (( obtained_at + expires_in > now + 60 ))
}

authorize_with_code() {
  local client_id encoded_client_id code
  client_id="$(jq -r '.client_id' "$CONFIG_FILE")"
  encoded_client_id="$(jq -nr --arg value "$client_id" '$value | @uri')"
  printf '请手动打开以下地址完成授权：\n%s\n' \
    "https://open.pingcode.com/oauth2/authorize?response_type=code&client_id=${encoded_client_id}" >&2
  IFS= read -r -p 'code: ' code
  [ -n "$code" ] || die "code 不能为空"
  request_tokens authorization_code "$code" ||
    die "获取令牌失败（HTTP ${HTTP_STATUS}）：${HTTP_BODY}"
  printf '鉴权成功，令牌已保存。\n' >&2
}

try_refresh_token() {
  local refresh_token
  refresh_token="$(jq -r '.refresh_token // empty' "$CONFIG_FILE")"
  [ -n "$refresh_token" ] || return 1
  printf 'access_token 已过期，正在刷新...\n' >&2
  if request_tokens refresh_token "$refresh_token" "$refresh_token"; then
    printf '令牌已刷新。\n' >&2
    return 0
  fi
  case "$HTTP_STATUS" in
    400|401) ;;
    *) die "刷新令牌失败（HTTP ${HTTP_STATUS}）：${HTTP_BODY}" ;;
  esac
  printf 'refresh_token 已失效，需要重新授权。\n' >&2
  return 1
}

renew_token() {
  if try_refresh_token; then
    return
  fi
  clear_tokens
  authorize_with_code
}

ensure_token() {
  validate_config
  token_is_valid || renew_token
}

cmd_auth() {
  [ "$#" -eq 0 ] || die "auth 不接受参数"
  validate_config
  if token_is_valid; then
    printf 'access_token 仍然有效。\n' >&2
    return
  fi
  renew_token
}

api_request() {
  local method="$1" endpoint="$2"
  shift 2
  ensure_token
  local token
  token="$(jq -r '.access_token' "$CONFIG_FILE")"
  http_request "$method" "${API_BASE}${endpoint}" \
    -H 'Accept: application/json' \
    -H "Authorization: Bearer ${token}" "$@"

  if [ "$HTTP_STATUS" = "401" ]; then
    renew_token
    token="$(jq -r '.access_token' "$CONFIG_FILE")"
    http_request "$method" "${API_BASE}${endpoint}" \
      -H 'Accept: application/json' \
      -H "Authorization: Bearer ${token}" "$@"
  fi
  [ "$HTTP_STATUS" -ge 200 ] && [ "$HTTP_STATUS" -lt 300 ] ||
    die "PingCode API 请求失败（HTTP ${HTTP_STATUS}）：${HTTP_BODY}"
  printf '%s\n' "$HTTP_BODY"
}

fetch_projects() {
  local page=0 all='[]' previous_count=-1 response page_count total count
  while :; do
    response="$(api_request GET '/v1/project/projects' --get \
      --data-urlencode "page_index=${page}" --data-urlencode 'page_size=100')"
    jq -e '.values | type == "array"' <<< "$response" >/dev/null 2>&1 ||
      die "项目列表响应缺少 values 数组"
    all="$(jq -cn --argjson old "$all" --argjson new "$(jq '.values' <<< "$response")" \
      '$old + $new | map(select((.id | type) == "string" and (.name | type) == "string")) | unique_by(.id)')"
    page_count="$(jq '.values | length' <<< "$response")"
    total="$(jq -er '
      (.total // (.values | length)) as $total |
      select(($total | type) == "number" and $total >= 0 and $total == ($total | floor)) |
      $total
    ' <<< "$response")" || die "项目列表响应的 total 无效"
    count="$(jq 'length' <<< "$all")"
    (( count >= total )) && break
    (( page_count > 0 && count > previous_count )) || die "项目列表分页没有前进，已停止请求"
    previous_count="$count"
    page=$((page + 1))
  done
  printf '%s\n' "$all"
}

cmd_projects_refresh() {
  validate_config
  local raw_projects projects='[]' project project_id project_name response states cached_project
  raw_projects="$(fetch_projects)"
  while IFS= read -r project; do
    project_id="$(jq -r '.id' <<< "$project")"
    project_name="$(jq -r '.name' <<< "$project")"
    response="$(api_request GET '/v1/project/work_item/states' --get \
      --data-urlencode "project_id=${project_id}" \
      --data-urlencode 'work_item_type_id=bug' \
      --data-urlencode 'page_index=0' \
      --data-urlencode 'page_size=100')"
    jq -e '.values | type == "array"' <<< "$response" >/dev/null 2>&1 ||
      die "项目 ${project_name} 的状态响应缺少 values 数组"
    states="$(jq '[.values[] | select((.id | type) == "string" and (.name | type) == "string") | {id, name}] | unique_by(.id)' <<< "$response")"
    cached_project="$(jq -cn --arg id "$project_id" --arg name "$project_name" --argjson states "$states" \
      '{id: $id, name: $name, states: $states}')"
    projects="$(jq -cn --argjson projects "$projects" --argjson project "$cached_project" '$projects + [$project]')"
  done < <(jq -c '.[]' <<< "$raw_projects")

  local refreshed_at
  refreshed_at="$(date +%s)"
  write_config '.projects = $projects | .projects_refreshed_at = $refreshed_at' \
    --argjson projects "$projects" --argjson refreshed_at "$refreshed_at"
  printf '已缓存 %s 个项目及其 bug 状态。\n' "$(jq 'length' <<< "$projects")" >&2
}

projects_cache_is_valid() {
  jq -e '
    ((.projects_refreshed_at | type) == "number") and
    (.projects | type == "array") and
    all(.projects[];
      (.id | type == "string" and length > 0) and
      (.name | type == "string" and length > 0) and
      (.states | type == "array") and
      all(.states[]; (.id | type == "string" and length > 0) and (.name | type == "string" and length > 0))
    )
  ' "$CONFIG_FILE" >/dev/null 2>&1
}

ensure_projects() {
  validate_config
  if ! projects_cache_is_valid; then
    printf '项目缓存不存在或不完整，正在获取...\n' >&2
    cmd_projects_refresh
  fi
}

cmd_projects() {
  [ "$#" -le 1 ] || die "用法：pingcode-cli projects [refresh]"
  local subcommand="${1:-}"
  case "$subcommand" in
    "") ensure_projects ;;
    refresh) cmd_projects_refresh ;;
    *) die "未知 projects 子命令：${subcommand}" ;;
  esac
  jq '[.projects[] | {id, name, states}]' "$CONFIG_FILE"
}

resolve_project() {
  local name="$1" matches count
  ensure_projects
  matches="$(jq --arg name "$name" '[.projects[] | select(.name == $name)]' "$CONFIG_FILE")"
  count="$(jq 'length' <<< "$matches")"
  [ "$count" -gt 0 ] || die "找不到项目：${name}。请运行 pingcode-cli projects 查看缓存"
  [ "$count" -eq 1 ] || die "存在多个同名项目：${name}"
  jq -c '.[0]' <<< "$matches"
}

resolve_state_id() {
  local project="$1" name="$2" ids count
  ids="$(jq --arg name "$name" '[.states[] | select(.name == $name) | .id] | unique' <<< "$project")"
  count="$(jq 'length' <<< "$ids")"
  [ "$count" -gt 0 ] || return 1
  [ "$count" -eq 1 ] || die "项目内存在多个同名状态：${name}"
  jq -r '.[0]' <<< "$ids"
}

fetch_work_items() {
  local project_id="$1" state_id="$2" assignee_id="$3"
  local page=0 all='[]' previous_count=-1 response page_count total count
  while :; do
    response="$(api_request GET '/v1/project/work_items' --get \
      --data-urlencode "project_id=${project_id}" \
      --data-urlencode "assignee_id=${assignee_id}" \
      --data-urlencode "state_id=${state_id}" \
      --data-urlencode 'type_id=bug' \
      --data-urlencode "page_index=${page}" \
      --data-urlencode 'page_size=100')"
    jq -e '.values | type == "array"' <<< "$response" >/dev/null 2>&1 ||
      die "工作项列表响应缺少 values 数组"
    all="$(jq -cn --argjson old "$all" --argjson new "$(jq '.values' <<< "$response")" \
      '$old + $new | unique_by(.id)')"
    page_count="$(jq '.values | length' <<< "$response")"
    total="$(jq -er '
      (.total // (.values | length)) as $total |
      select(($total | type) == "number" and $total >= 0 and $total == ($total | floor)) |
      $total
    ' <<< "$response")" || die "工作项列表响应的 total 无效"
    count="$(jq 'length' <<< "$all")"
    (( count >= total )) && break
    (( page_count > 0 && count > previous_count )) || die "工作项列表分页没有前进，已停止请求"
    previous_count="$count"
    page=$((page + 1))
  done
  printf '%s\n' "$all"
}

shape_bugs() {
  local cutoff="$1"
  jq --arg cutoff "$cutoff" '
    ($cutoff | if . == "null" then null else tonumber end) as $created_after |
    [
      .[] |
      select($created_after == null or (.created_at // 0) > $created_after) |
      {
        id: (.id // ""),
        identifier: (.identifier // ""),
        title: (.title // ""),
        html_url: (.html_url // ""),
        state: (.state // null),
        description: (.description // "")
      }
    ] | sort_by(.identifier)
  '
}

shape_bug() {
  jq '{
    id: (.id // ""),
    identifier: (.identifier // ""),
    title: (.title // ""),
    html_url: (.html_url // ""),
    state: (.state // null),
    description: (.description // "")
  }'
}

cmd_bugs() {
  local project_name="" cutoff="" state_name project project_id assignee_id state_id items='[]' batch
  local -a state_names=() state_ids=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --project)
        need_arg "$1" "${2:-}"
        project_name="$2"
        shift 2
        ;;
      --project=*) project_name="${1#*=}"; shift ;;
      --state)
        need_arg "$1" "${2:-}"
        state_names+=("$2")
        shift 2
        ;;
      --state=*) state_names+=("${1#*=}"); shift ;;
      --created-after)
        need_arg "$1" "${2:-}"
        cutoff="$2"
        shift 2
        ;;
      --created-after=*)
        cutoff="${1#*=}"
        [ -n "$cutoff" ] || die "--created-after 需要参数"
        shift
        ;;
      *) die "未知 bugs 选项：$1" ;;
    esac
  done
  [ -n "$project_name" ] || die "bugs 需要 --project <项目名称>"
  [ -z "$cutoff" ] || validate_timestamp "$cutoff"

  project="$(resolve_project "$project_name")"
  project_id="$(jq -r '.id' <<< "$project")"
  assignee_id="$(jq -r '.my_assignee_id' "$CONFIG_FILE")"
  if [ "${#state_names[@]}" -eq 0 ]; then
    readarray -t state_ids < <(jq -r '.states[].id' <<< "$project")
  else
    for state_name in "${state_names[@]}"; do
      state_id="$(resolve_state_id "$project" "$state_name")" ||
        die "项目 ${project_name} 没有状态：${state_name}"
      state_ids+=("$state_id")
    done
  fi
  [ "${#state_ids[@]}" -gt 0 ] || die "项目 ${project_name} 没有缓存任何 bug 状态，请运行 pingcode-cli projects refresh"

  readarray -t state_ids < <(printf '%s\n' "${state_ids[@]}" | awk '!seen[$0]++')
  for state_id in "${state_ids[@]}"; do
    batch="$(fetch_work_items "$project_id" "$state_id" "$assignee_id")"
    items="$(jq -cn --argjson old "$items" --argjson new "$batch" '$old + $new | unique_by(.id)')"
  done

  if [ -z "$cutoff" ]; then
    cutoff="$(jq -c '.created_after' "$CONFIG_FILE")"
  fi
  [ "$cutoff" = "null" ] || cutoff="${cutoff:-null}"
  shape_bugs "$cutoff" <<< "$items"
}

get_bug() {
  [[ "$1" =~ ^[A-Za-z0-9_-]+$ ]] || die "无效的 bug id：$1"
  api_request GET "/v1/project/work_items/$1"
}

cmd_bug() {
  [ "$#" -eq 1 ] || die "用法：pingcode-cli bug <bug_id>"
  get_bug "$1" | shape_bug
}

cmd_set_state() {
  [ "$#" -eq 2 ] || die "用法：pingcode-cli set-state <bug_id> <状态名称>"
  local bug_id="$1" state_name="$2" bug project_id project state_id response
  bug="$(get_bug "$bug_id")"
  project_id="$(jq -r '.project.id // empty' <<< "$bug")"
  [ -n "$project_id" ] || die "工作项响应缺少 project.id"
  ensure_projects
  project="$(jq -c --arg id "$project_id" '.projects[] | select(.id == $id)' "$CONFIG_FILE" | head -1)"
  if [ -z "$project" ]; then
    cmd_projects_refresh >/dev/null
    project="$(jq -c --arg id "$project_id" '.projects[] | select(.id == $id)' "$CONFIG_FILE" | head -1)"
  fi
  [ -n "$project" ] || die "项目缓存中找不到工作项所属项目：${project_id}"
  if ! state_id="$(resolve_state_id "$project" "$state_name")"; then
    cmd_projects_refresh >/dev/null
    project="$(jq -c --arg id "$project_id" '.projects[] | select(.id == $id)' "$CONFIG_FILE" | head -1)"
    state_id="$(resolve_state_id "$project" "$state_name")" ||
      die "项目中没有状态：${state_name}"
  fi

  response="$(api_request PATCH "/v1/project/work_items/${bug_id}" \
    -H 'Content-Type: application/json' \
    --data "$(jq -cn --arg state_id "$state_id" '{state_id: $state_id}')")"
  shape_bug <<< "$response"
}

usage() {
  cat <<'EOF'
pingcode-cli - 使用 PingCode 官方 API 管理 bug

用法：
  pingcode-cli init
  pingcode-cli auth
  pingcode-cli projects [refresh]
  pingcode-cli bugs --project <项目名称> [--state <状态名称>]... [--created-after <Unix 秒数>]
  pingcode-cli bug <bug_id>
  pingcode-cli set-state <bug_id> <状态名称>

命令：
  init        初始化 ~/.config/pingcode-cli/config.json
  auth        获取、刷新或重新获取用户令牌
  projects    查看项目缓存；refresh 重新获取项目及状态
  bugs        获取分配给我的 bug，可多次传入 --state
  bug         获取一个 bug
  set-state   修改一个 bug 的状态
EOF
}

usage_init() {
  cat <<'EOF'
pingcode-cli init - 初始化配置

用法：
  pingcode-cli init

交互内容：
  client_id、client_secret、my_assignee_id
  是否设置全局 created_at 起点（Unix 秒数）

配置文件：
  ~/.config/pingcode-cli/config.json
EOF
}

usage_auth() {
  cat <<'EOF'
pingcode-cli auth - 获取或刷新用户令牌

用法：
  pingcode-cli auth

access_token 有效时直接返回；过期时尝试 refresh_token。
refresh_token 不可用时输出授权地址，并等待输入 code。
EOF
}

usage_projects() {
  cat <<'EOF'
pingcode-cli projects - 管理项目缓存

用法：
  pingcode-cli projects
  pingcode-cli projects refresh

子命令：
  refresh  重新获取全部项目及每个项目的 bug 状态

不传子命令时输出缓存；缓存不存在或不完整时自动获取。
EOF
}

usage_bugs() {
  cat <<'EOF'
pingcode-cli bugs - 获取分配给我的 bug

用法：
  pingcode-cli bugs --project <项目名称> [选项]

选项：
  --state <状态名称>         可重复；省略时查询项目内全部缓存状态
  --created-after <Unix 秒数>  覆盖配置中的全局时间戳
  -h, --help                 显示帮助
EOF
}

usage_bug() {
  cat <<'EOF'
pingcode-cli bug - 获取一个 bug

用法：
  pingcode-cli bug <bug_id>

参数：
  bug_id  PingCode API 返回的工作项 id
EOF
}

usage_set_state() {
  cat <<'EOF'
pingcode-cli set-state - 修改 bug 状态

用法：
  pingcode-cli set-state <bug_id> <状态名称>

状态名称从工作项所属项目的状态缓存中解析；缓存过旧时自动刷新一次。
EOF
}

is_help() {
  local arg
  for arg in "$@"; do
    case "$arg" in -h|--help) return 0 ;; esac
  done
  return 1
}

case "${1:-}" in
  -h|--help|"") usage ;;
  init)
    shift
    is_help "$@" && { usage_init; exit 0; }
    require_commands
