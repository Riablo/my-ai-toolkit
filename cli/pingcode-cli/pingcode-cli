#!/usr/bin/env bash
set -euo pipefail

API_BASE="https://open.pingcode.com"
CONFIG_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/pingcode-cli"
CONFIG_FILE="${CONFIG_DIR}/config.json"
RUNTIME_DIR=""

init_runtime() {
  [ -n "$RUNTIME_DIR" ] && return
  RUNTIME_DIR="$(mktemp -d "${TMPDIR:-/tmp}/pingcode-cli.XXXXXX")"
  trap 'rm -rf "$RUNTIME_DIR"' EXIT
}

die() {
  printf '错误：%s\n' "$1" >&2
  exit 1
}

need_arg() {
  [ "$#" -ge 2 ] && [ -n "$2" ] || die "$1 需要参数"
}

require_commands() {
  local command
  for command in curl jq; do
    command -v "$command" >/dev/null 2>&1 || die "缺少依赖：${command}"
  done
  init_runtime
}

validate_timestamp() {
  [[ "$1" =~ ^[0-9]+$ ]] || die "时间戳必须是 Unix 秒数：$1"
}

# The small NUL-delimited snapshot is shared by command substitutions. Token
# refreshes atomically replace it, so later requests also see refreshed fields.
load_config_fields() {
  [ -f "$CONFIG_FILE" ] || die "尚未初始化。请先运行 pingcode-cli init"
  local snapshot
  snapshot="$(mktemp "$RUNTIME_DIR/auth.XXXXXX")"
  jq -j '
    if type != "object" then error("配置必须是 JSON 对象") else . end |
    ["client_id", "client_secret", "my_assignee_id"] as $keys |
    [. as $config | $keys[] | select($config[.] | type != "string" or length == 0)] as $missing |
    if ($missing | length) > 0 then error("配置缺少必要字段：" + ($missing | join(" "))) else . end |
    if (.created_after == null) or
      ((.created_after | type) == "number" and .created_after >= 0 and .created_after == (.created_after | floor))
    then . else error("配置字段 created_after 必须是 null 或 Unix 秒数") end |
    if (.projects // [] | type) == "array" then . else error("配置字段 projects 必须是数组") end |
    (.client_id, .client_secret, .my_assignee_id, (.created_after | tojson),
      (.access_token // ""), (.refresh_token // ""), (.expires_in // 0), (.token_obtained_at // 0)) |
    tostring + "\u0000"
  ' "$CONFIG_FILE" > "$snapshot" || die "配置校验失败：${CONFIG_FILE}"
  mv -f "$snapshot" "$RUNTIME_DIR/auth"
}

validate_config() {
  [ -f "$RUNTIME_DIR/auth" ] || load_config_fields
  local -a fields
  readarray -d '' -t fields < "$RUNTIME_DIR/auth"
  CLIENT_ID="${fields[0]}"
  CLIENT_SECRET="${fields[1]}"
  MY_ASSIGNEE_ID="${fields[2]}"
  CREATED_AFTER="${fields[3]}"
  ACCESS_TOKEN="${fields[4]}"
  REFRESH_TOKEN="${fields[5]}"
  EXPIRES_IN="${fields[6]}"
  TOKEN_OBTAINED_AT="${fields[7]}"
}

write_config() {
  local filter="$1"
  shift
  local tmp
  tmp="$(mktemp "${CONFIG_DIR}/config.XXXXXX")"
  jq "$@" "$filter" "$CONFIG_FILE" > "$tmp" || {
    rm -f "$tmp"
    die "无法更新配置：${CONFIG_FILE}"
  }
  chmod 600 "$tmp"
  mv -f "$tmp" "$CONFIG_FILE"
  load_config_fields
  validate_config
}

cmd_init() {
  [ "$#" -eq 0 ] || die "init 不接受参数"
  local client_id client_secret my_assignee_id set_created_after created_after=""
  IFS= read -r -p 'client_id: ' client_id
  IFS= read -r -s -p 'client_secret: ' client_secret
  printf '\n' >&2
  IFS= read -r -p 'my_assignee_id: ' my_assignee_id
  [ -n "$client_id" ] || die "client_id 不能为空"
  [ -n "$client_secret" ] || die "client_secret 不能为空"
  [ -n "$my_assignee_id" ] || die "my_assignee_id 不能为空"
  IFS= read -r -p '是否设置全局 created_at 起点？[y/N]: ' set_created_after
  case "$set_created_after" in
    y|Y|yes|YES|是)
      IFS= read -r -p 'created_after（Unix 秒数）: ' created_after
      validate_timestamp "$created_after"
      ;;
  esac

  mkdir -p "$CONFIG_DIR"
  local tmp
  tmp="$(mktemp "${CONFIG_DIR}/config.XXXXXX")"
  jq -n \
    --arg client_id "$client_id" \
    --arg client_secret "$client_secret" \
    --arg my_assignee_id "$my_assignee_id" \
    --arg created_after "$created_after" '
      {
        client_id: $client_id,
        client_secret: $client_secret,
        my_assignee_id: $my_assignee_id,
        created_after: (if $created_after == "" then null else ($created_after | tonumber) end),
        access_token: null,
        refresh_token: null,
        expires_in: null,
        token_obtained_at: null,
        projects: [],
        projects_refreshed_at: null
      }
    ' > "$tmp"
  chmod 600 "$tmp"
  mv -f "$tmp" "$CONFIG_FILE"
  printf '配置已保存到 %s\n' "$CONFIG_FILE" >&2
}

HTTP_STATUS=""
HTTP_BODY=""

http_request() {
  local method="$1" url="$2"
  shift 2
  local raw
  raw="$(curl --silent --show-error --location \
    --connect-timeout 10 --max-time 60 \
    --request "$method" --write-out $'\n%{http_code}' \
    "$url" "$@")" || die "网络请求失败：${url}"
  HTTP_STATUS="${raw##*$'\n'}"
  HTTP_BODY="${raw%$'\n'*}"
  [[ "$HTTP_STATUS" =~ ^[0-9]{3}$ ]] || die "无法读取 HTTP 状态码"
}

save_tokens() {
  local response="$1" fallback_refresh="${2:-}" token_file
  token_file="$(mktemp "$RUNTIME_DIR/tokens.XXXXXX")"
  jq --arg fallback "$fallback_refresh" --argjson now "$EPOCHSECONDS" '
    select((.access_token | type == "string" and length > 0) and
      ((.expires_in | type) == "number" and .expires_in > 0 and .expires_in == (.expires_in | floor))) |
    (.refresh_token // "" | if . == "" then $fallback else . end) as $refresh |
    select($refresh | type == "string" and length > 0) |
    {access_token, refresh_token: $refresh, expires_in, token_obtained_at: $now}
  ' <<< "$response" > "$token_file" || return 1
  [ -s "$token_file" ] || return 1
  write_config '. + $tokens[0]' --slurpfile tokens "$token_file"
}

request_tokens() {
  local grant_type="$1" value="$2" fallback_refresh="${3:-}"
  local client_id client_secret
  client_id="$CLIENT_ID"
  client_secret="$CLIENT_SECRET"

  if [ "$grant_type" = "authorization_code" ]; then
    http_request GET "${API_BASE}/v1/auth/token" --get \
      --data-urlencode 'grant_type=authorization_code' \
      --data-urlencode "client_id=${client_id}" \
      --data-urlencode "client_secret=${client_secret}" \
      --data-urlencode "code=${value}"
  else
    http_request GET "${API_BASE}/v1/auth/token" --get \
      --data-urlencode 'grant_type=refresh_token' \
      --data-urlencode "refresh_token=${value}"
  fi

  [ "$HTTP_STATUS" -ge 200 ] && [ "$HTTP_STATUS" -lt 300 ] || return 1
  save_tokens "$HTTP_BODY" "$fallback_refresh"
}

clear_tokens() {
  write_config '
    .access_token = null |
    .refresh_token = null |
    .expires_in = null |
    .token_obtained_at = null
  '
}

token_is_valid() {
  [[ "$EXPIRES_IN" =~ ^[0-9]+$ && "$TOKEN_OBTAINED_AT" =~ ^[0-9]+$ ]] || return 1
  [ -n "$ACCESS_TOKEN" ] && (( TOKEN_OBTAINED_AT + EXPIRES_IN > EPOCHSECONDS + 60 ))
}

authorize_with_code() {
  local client_id encoded_client_id code
  client_id="$CLIENT_ID"
  encoded_client_id="$(jq -nr --arg value "$client_id" '$value | @uri')"
  printf '请手动打开以下地址完成授权：\n%s\n' \
    "https://open.pingcode.com/oauth2/authorize?response_type=code&client_id=${encoded_client_id}" >&2
  IFS= read -r -p 'code: ' code
  [ -n "$code" ] || die "code 不能为空"
  request_tokens authorization_code "$code" ||
    die "获取令牌失败（HTTP ${HTTP_STATUS}）：${HTTP_BODY}"
  printf '鉴权成功，令牌已保存。\n' >&2
}

try_refresh_token() {
  local refresh_token
  refresh_token="$REFRESH_TOKEN"
  [ -n "$refresh_token" ] || return 1
  printf 'access_token 已过期，正在刷新...\n' >&2
  if request_tokens refresh_token "$refresh_token" "$refresh_token"; then
    printf '令牌已刷新。\n' >&2
    return 0
  fi
  case "$HTTP_STATUS" in
    400|401) ;;
    *) die "刷新令牌失败（HTTP ${HTTP_STATUS}）：${HTTP_BODY}" ;;
  esac
  printf 'refresh_token 已失效，需要重新授权。\n' >&2
  return 1
}

renew_token() {
  if try_refresh_token; then
    return
  fi
  clear_tokens
  authorize_with_code
}

ensure_token() {
  validate_config
  token_is_valid || renew_token
}

cmd_auth() {
  [ "$#" -eq 0 ] || die "auth 不接受参数"
  validate_config
  if token_is_valid; then
    printf 'access_token 仍然有效。\n' >&2
    return
  fi
  renew_token
}

api_request() {
  local method="$1" endpoint="$2"
  shift 2
  ensure_token
  local token
  token="$ACCESS_TOKEN"
  http_request "$method" "${API_BASE}${endpoint}" \
    -H 'Accept: application/json' \
    -H "Authorization: Bearer ${token}" "$@"

  if [ "$HTTP_STATUS" = "401" ]; then
    renew_token
    token="$ACCESS_TOKEN"
    http_request "$method" "${API_BASE}${endpoint}" \
      -H 'Accept: application/json' \
      -H "Authorization: Bearer ${token}" "$@"
  fi
  [ "$HTTP_STATUS" -ge 200 ] && [ "$HTTP_STATUS" -lt 300 ] ||
    die "PingCode API 请求失败（HTTP ${HTTP_STATUS}）：${HTTP_BODY}"
  printf '%s\n' "$HTTP_BODY"
}

fetch_paginated() {
  local endpoint="$1" kind="$2" label="$3"
  shift 3
  local page=0 previous_count=-1 total page_count id count=0
  local response_file metadata_file items_file
  local -A seen=()
  response_file="$(mktemp "$RUNTIME_DIR/response.XXXXXX")"
  metadata_file="$(mktemp "$RUNTIME_DIR/metadata.XXXXXX")"
  items_file="$(mktemp "$RUNTIME_DIR/items.XXXXXX")"
  while :; do
    api_request GET "$endpoint" --get "$@" \
      --data-urlencode "page_index=${page}" --data-urlencode 'page_size=100' > "$response_file"
    jq -r --arg kind "$kind" '
      if (.values | type) != "array" then error("响应缺少 values 数组") else . end |
      (.total // (.values | length)) as $total |
      if ($total | type) == "number" and $total >= 0 and $total == ($total | floor)
      then . else error("响应的 total 无效") end |
      ([$total, (.values | length)] | @tsv),
      (.values[] | select($kind != "projects" or
        ((.id | type) == "string" and (.name | type) == "string")) | .id | tojson)
    ' "$response_file" > "$metadata_file" || die "${label}响应无效"
    {
      IFS=$'\t' read -r total page_count
      while IFS= read -r id; do
        if [[ ${seen["$id"]+present} != present ]]; then
          seen["$id"]=1
          count=$((count + 1))
        fi
      done
    } < "$metadata_file"
    jq -c --arg kind "$kind" '.values[] | select($kind != "projects" or
      ((.id | type) == "string" and (.name | type) == "string"))' "$response_file" >> "$items_file"
    (( count >= total )) && break
    (( page_count > 0 && count > previous_count )) || die "${label}分页没有前进，已停止请求"
    previous_count="$count"
    page=$((page + 1))
  done
  jq -s 'unique_by(.id)' "$items_file"
}

fetch_projects() {
  fetch_paginated '/v1/project/projects' projects 项目列表
}

cmd_projects_refresh() {
  validate_config
  local raw_projects projects_file project project_id project_name response
  raw_projects="$(mktemp "$RUNTIME_DIR/projects-raw.XXXXXX")"
  projects_file="$(mktemp "$RUNTIME_DIR/projects.XXXXXX")"
  fetch_projects > "$raw_projects"
  while IFS= read -r project; do
    project_id="$(jq -r '.id' <<< "$project")"
    project_name="$(jq -r '.name' <<< "$project")"
    response="$(api_request GET '/v1/project/work_item/states' --get \
      --data-urlencode "project_id=${project_id}" \
      --data-urlencode 'work_item_type_id=bug' \
      --data-urlencode 'page_index=0' \
      --data-urlencode 'page_size=100')"
    jq -c --arg id "$project_id" --arg name "$project_name" '
      if (.values | type) != "array" then error("状态响应缺少 values 数组") else . end |
      {id: $id, name: $name, states: [.values[] |
        select((.id | type) == "string" and (.name | type) == "string") | {id, name}] | unique_by(.id)}
    ' <<< "$response" >> "$projects_file" || die "项目 ${project_name} 的状态响应无效"
  done < <(jq -c '.[]' "$raw_projects")

  write_config '.projects = $projects | .projects_refreshed_at = $refreshed_at' \
    --slurpfile projects "$projects_file" --argjson refreshed_at "$EPOCHSECONDS"
  printf '已缓存 %s 个项目及其 bug 状态。\n' "$(jq -s 'length' "$projects_file")" >&2
}

projects_cache_is_valid() {
  jq -e '
    ((.projects_refreshed_at | type) == "number") and
    (.projects | type == "array") and
    all(.projects[];
      (.id | type == "string" and length > 0) and
      (.name | type == "string" and length > 0) and
      (.states | type == "array") and
      all(.states[]; (.id | type == "string" and length > 0) and (.name | type == "string" and length > 0))
    )
  ' "$CONFIG_FILE" >/dev/null 2>&1
}

ensure_projects() {
  validate_config
  if ! projects_cache_is_valid; then
    printf '项目缓存不存在或不完整，正在获取...\n' >&2
    cmd_projects_refresh
  fi
}

cmd_projects() {
  [ "$#" -le 1 ] || die "用法：pingcode-cli projects [refresh]"
  local subcommand="${1:-}"
  case "$subcommand" in
    "") ensure_projects ;;
    refresh) cmd_projects_refresh ;;
    *) die "未知 projects 子命令：${subcommand}" ;;
  esac
  jq '[.projects[] | {id, name, states}]' "$CONFIG_FILE"
}

resolve_project() {
  local name="$1" matches count
  ensure_projects
  matches="$(jq --arg name "$name" '[.projects[] | select(.name == $name)]' "$CONFIG_FILE")"
  count="$(jq 'length' <<< "$matches")"
  [ "$count" -gt 0 ] || die "找不到项目：${name}。请运行 pingcode-cli projects 查看缓存"
  [ "$count" -eq 1 ] || die "存在多个同名项目：${name}"
  jq -c '.[0]' <<< "$matches"
}

resolve_state_id() {
  local project="$1" name="$2" ids count
  ids="$(jq --arg name "$name" '[.states[] | select(.name == $name) | .id] | unique' <<< "$project")"
  count="$(jq 'length' <<< "$ids")"
  [ "$count" -gt 0 ] || return 1
  [ "$count" -eq 1 ] || die "项目内存在多个同名状态：${name}"
  jq -r '.[0]' <<< "$ids"
}

fetch_work_items() {
  local project_id="$1" state_id="$2" assignee_id="$3"
  fetch_paginated '/v1/project/work_items' work_items 工作项列表 \
    --data-urlencode "project_id=${project_id}" \
    --data-urlencode "assignee_id=${assignee_id}" \
    --data-urlencode "state_id=${state_id}" \
    --data-urlencode 'type_id=bug' \
    --data-urlencode 'include_public_image_token=description'
}

add_image_access_tokens() {
  jq '
    def add_image_access_token:
      (.public_image_token // "") as $token |
      .description = (
        (.description // "") |
        if ($token | type) == "string" and ($token | length) > 0 then
          gsub(
            "(?i)(?<prefix><img[^>]*[[:space:]]src[[:space:]]*=[[:space:]]*[\"\u0027])(?<src>[^\"\u0027>]+)";
            if (.src | test("[?&]access_token=")) then
              "\(.prefix)\(.src)"
            else
              "\(.prefix)\(.src)\(if (.src | contains("?")) then "&" else "?" end)access_token=\($token)"
            end
          )
        else . end
      );
    if type == "array" then map(add_image_access_token) else add_image_access_token end
  '
}

shape_bugs() {
  local cutoff="$1"
  add_image_access_tokens | jq --arg cutoff "$cutoff" '
    ($cutoff | if . == "null" then null else tonumber end) as $created_after |
    [
      .[] |
      select($created_after == null or (.created_at // 0) > $created_after) |
      {
        id: (.id // ""),
        identifier: (.identifier // ""),
        title: (.title // ""),
        html_url: (.html_url // ""),
        state: (.state // null),
        description: (.description // "")
      }
    ] | sort_by(.identifier)
  '
}

shape_bug() {
  add_image_access_tokens | jq '{
    id: (.id // ""),
    identifier: (.identifier // ""),
    title: (.title // ""),
    html_url: (.html_url // ""),
    state: (.state // null),
    description: (.description // "")
  }'
}

cmd_bugs() {
  local project_name="" cutoff="" state_name project project_id assignee_id state_id batches_file
  local -a state_names=() state_ids=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --project)
        need_arg "$1" "${2:-}"
        project_name="$2"
        shift 2
        ;;
      --project=*) project_name="${1#*=}"; shift ;;
      --state)
        need_arg "$1" "${2:-}"
        state_names+=("$2")
        shift 2
        ;;
      --state=*) state_names+=("${1#*=}"); shift ;;
      --created-after)
        need_arg "$1" "${2:-}"
        cutoff="$2"
        shift 2
        ;;
      --created-after=*)
        cutoff="${1#*=}"
        [ -n "$cutoff" ] || die "--created-after 需要参数"
        shift
        ;;
      *) die "未知 bugs 选项：$1" ;;
    esac
  done
  [ -n "$project_name" ] || die "bugs 需要 --project <项目名称>"
  [ -z "$cutoff" ] || validate_timestamp "$cutoff"

  validate_config
  project="$(resolve_project "$project_name")"
  project_id="$(jq -r '.id' <<< "$project")"
  assignee_id="$MY_ASSIGNEE_ID"
  if [ "${#state_names[@]}" -eq 0 ]; then
    readarray -t state_ids < <(jq -r '.states[].id' <<< "$project")
  else
    for state_name in "${state_names[@]}"; do
      state_id="$(resolve_state_id "$project" "$state_name")" ||
        die "项目 ${project_name} 没有状态：${state_name}"
      state_ids+=("$state_id")
    done
  fi
  [ "${#state_ids[@]}" -gt 0 ] || die "项目 ${project_name} 没有缓存任何 bug 状态，请运行 pingcode-cli projects refresh"

  readarray -t state_ids < <(printf '%s\n' "${state_ids[@]}" | awk '!seen[$0]++')
  batches_file="$(mktemp "$RUNTIME_DIR/batches.XXXXXX")"
  for state_id in "${state_ids[@]}"; do
    fetch_work_items "$project_id" "$state_id" "$assignee_id" >> "$batches_file"
  done

  if [ -z "$cutoff" ]; then
    cutoff="$CREATED_AFTER"
  fi
  [ "$cutoff" = "null" ] || cutoff="${cutoff:-null}"
  jq -s 'add | unique_by(.id)' "$batches_file" | shape_bugs "$cutoff"
}

get_bug() {
  [[ "$1" =~ ^[A-Za-z0-9_-]+$ ]] || die "无效的 bug id：$1"
  api_request GET "/v1/project/work_items/$1" --get \
    --data-urlencode 'include_public_image_token=description'
}

cmd_bug() {
  [ "$#" -eq 1 ] || die "用法：pingcode-cli bug <bug_id>"
  get_bug "$1" | shape_bug
}

cmd_set_state() {
  [ "$#" -eq 2 ] || die "用法：pingcode-cli set-state <bug_id> <状态名称>"
  local bug_id="$1" state_name="$2" bug project_id project state_id response
  bug="$(get_bug "$bug_id")"
  project_id="$(jq -r '.project.id // empty' <<< "$bug")"
  [ -n "$project_id" ] || die "工作项响应缺少 project.id"
  ensure_projects
  project="$(jq -c --arg id "$project_id" '.projects[] | select(.id == $id)' "$CONFIG_FILE" | head -1)"
  if [ -z "$project" ]; then
    cmd_projects_refresh >/dev/null
    project="$(jq -c --arg id "$project_id" '.projects[] | select(.id == $id)' "$CONFIG_FILE" | head -1)"
  fi
  [ -n "$project" ] || die "项目缓存中找不到工作项所属项目：${project_id}"
  if ! state_id="$(resolve_state_id "$project" "$state_name")"; then
    cmd_projects_refresh >/dev/null
    project="$(jq -c --arg id "$project_id" '.projects[] | select(.id == $id)' "$CONFIG_FILE" | head -1)"
    state_id="$(resolve_state_id "$project" "$state_name")" ||
      die "项目中没有状态：${state_name}"
  fi

  response="$(api_request PATCH "/v1/project/work_items/${bug_id}" \
    -H 'Content-Type: application/json' \
    --data "$(jq -cn --arg state_id "$state_id" '{state_id: $state_id}')")"
  shape_bug <<< "$response"
}

usage() {
  cat <<'EOF'
pingcode-cli - 使用 PingCode 官方 API 管理 bug

用法：
  pingcode-cli init
  pingcode-cli auth
  pingcode-cli projects [refresh]
  pingcode-cli bugs --project <项目名称> [--state <状态名称>]... [--created-after <Unix 秒数>]
  pingcode-cli bug <bug_id>
  pingcode-cli set-state <bug_id> <状态名称>

命令：
  init        初始化 ~/.config/pingcode-cli/config.json
  auth        获取、刷新或重新获取用户令牌
  projects    查看项目缓存；refresh 重新获取项目及状态
  bugs        获取分配给我的 bug，可多次传入 --state
  bug         获取一个 bug
  set-state   修改一个 bug 的状态
EOF
}

usage_init() {
  cat <<'EOF'
pingcode-cli init - 初始化配置

用法：
  pingcode-cli init

交互内容：
  client_id、client_secret、my_assignee_id
  是否设置全局 created_at 起点（Unix 秒数）

配置文件：
  ~/.config/pingcode-cli/config.json
EOF
}

usage_auth() {
  cat <<'EOF'
pingcode-cli auth - 获取或刷新用户令牌

用法：
  pingcode-cli auth

access_token 有效时直接返回；过期时尝试 refresh_token。
refresh_token 不可用时输出授权地址，并等待输入 code。
EOF
}

usage_projects() {
  cat <<'EOF'
pingcode-cli projects - 管理项目缓存

用法：
  pingcode-cli projects
  pingcode-cli projects refresh

子命令：
  refresh  重新获取全部项目及每个项目的 bug 状态

不传子命令时输出缓存；缓存不存在或不完整时自动获取。
EOF
}

usage_bugs() {
  cat <<'EOF'
pingcode-cli bugs - 获取分配给我的 bug

用法：
  pingcode-cli bugs --project <项目名称> [选项]

选项：
  --state <状态名称>         可重复；省略时查询项目内全部缓存状态
  --created-after <Unix 秒数>  覆盖配置中的全局时间戳
  -h, --help                 显示帮助
EOF
}

usage_bug() {
  cat <<'EOF'
pingcode-cli bug - 获取一个 bug

用法：
  pingcode-cli bug <bug_id>

参数：
  bug_id  PingCode API 返回的工作项 id
EOF
}

usage_set_state() {
  cat <<'EOF'
pingcode-cli set-state - 修改 bug 状态

用法：
  pingcode-cli set-state <bug_id> <状态名称>

状态名称从工作项所属项目的状态缓存中解析；缓存过旧时自动刷新一次。
EOF
}

is_help() {
  local arg
  for arg in "$@"; do
    case "$arg" in -h|--help) return 0 ;; esac
  done
  return 1
}

case "${1:-}" in
  -h|--help|"") usage ;;
  init)
    shift
    is_help "$@" && { usage_init; exit 0; }
    require_commands
    cmd_init "$@"
    ;;
  auth)
    shift
    is_help "$@" && { usage_auth; exit 0; }
    require_commands
    validate_config
    cmd_auth "$@"
    ;;
  projects)
    shift
    is_help "$@" && { usage_projects; exit 0; }
    require_commands
    validate_config
    cmd_projects "$@"
    ;;
  bugs)
    shift
    is_help "$@" && { usage_bugs; exit 0; }
    require_commands
    validate_config
    cmd_bugs "$@"
    ;;
  bug)
    shift
    is_help "$@" && { usage_bug; exit 0; }
    require_commands
    validate_config
    cmd_bug "$@"
    ;;
  set-state)
    shift
    is_help "$@" && { usage_set_state; exit 0; }
    require_commands
    validate_config
    cmd_set_state "$@"
    ;;
  *) die "未知命令：$1。使用 pingcode-cli --help 查看帮助" ;;
esac
