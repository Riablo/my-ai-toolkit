#!/usr/bin/env bash
set -euo pipefail

API_BASE="https://open.pingcode.com"
BUG_STATES=(
  '已拒绝:5f3a1c2fc2742c0e3b7dcbd0'
  '重新打开:5f3a1c2fc2742c17f27dcbce'
  '已修复:5f3a1c2fc2742c20e17dcbcd'
  '新提交:5f3a1c2fc2742c538a7dcbcb'
  '挂起:5f3a1c2fc2742c5fc47dcbd1'
  '已发布:5f3a1c2fc2742cacfb7dcbcf'
  '处理中:5f3a1c2fc2742cef1d7dcbcc'
)
CONFIG_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/pingcode-cli"
CONFIG_FILE="${CONFIG_DIR}/config.json"
RUNTIME_DIR=""

init_runtime() {
  [ -n "$RUNTIME_DIR" ] && return
  RUNTIME_DIR="$(mktemp -d "${TMPDIR:-/tmp}/pingcode-cli.XXXXXX")"
  trap 'rm -rf "$RUNTIME_DIR"' EXIT
}

die() {
  printf '错误：%s\n' "$1" >&2
  exit 1
}

need_arg() {
  [ "$#" -ge 2 ] && [ -n "$2" ] || die "$1 需要参数"
}

require_commands() {
  (( BASH_VERSINFO[0] >= 5 )) || die "需要 Bash 5.0+"
  local command
  for command in curl jq; do
    command -v "$command" >/dev/null 2>&1 || die "缺少依赖：${command}"
  done
  init_runtime
}

validate_timestamp() {
  [[ "$1" =~ ^[0-9]+$ ]] || die "时间戳必须是 Unix 秒数：$1"
}

# The small NUL-delimited snapshot is shared by command substitutions. Token
# refreshes atomically replace it, so later requests also see refreshed fields.
load_config_fields() {
  [ -f "$CONFIG_FILE" ] || die "尚未初始化。请先运行 pingcode-cli config init"
  local snapshot
  snapshot="$(mktemp "$RUNTIME_DIR/auth.XXXXXX")"
  jq -ej '
    if type != "object" then error("配置必须是 JSON 对象") else . end |
    ["client_id", "client_secret", "my_assignee_id"] as $keys |
    [. as $config | $keys[] | select($config[.] | type != "string" or length == 0)] as $missing |
    if ($missing | length) > 0 then error("配置缺少必要字段：" + ($missing | join(" "))) else . end |
    if (.created_after == null) or
      ((.created_after | type) == "number" and .created_after >= 0 and .created_after == (.created_after | floor))
    then . else error("配置字段 created_after 必须是 null 或 Unix 秒数") end |
    if all(.access_token, .refresh_token; . == null or type == "string") and
      all(.expires_in, .token_obtained_at; . == null or
        (type == "number" and . >= 0 and . == floor))
    then . else error("配置中的令牌字段格式无效") end |
    if (.projects // [] | type) == "array" then . else error("配置字段 projects 必须是数组") end |
    (.client_id, .client_secret, .my_assignee_id, (.created_after | tojson),
      (.access_token // ""), (.refresh_token // ""), (.expires_in // 0), (.token_obtained_at // 0)) |
    tostring + "\u0000"
  ' "$CONFIG_FILE" > "$snapshot" || die "配置校验失败：${CONFIG_FILE}"
  mv -f "$snapshot" "$RUNTIME_DIR/auth"
}

validate_config() {
  [ -f "$RUNTIME_DIR/auth" ] || load_config_fields
  local -a fields
  readarray -d '' -t fields < "$RUNTIME_DIR/auth"
  CLIENT_ID="${fields[0]}"
  CLIENT_SECRET="${fields[1]}"
  MY_ASSIGNEE_ID="${fields[2]}"
  CREATED_AFTER="${fields[3]}"
  ACCESS_TOKEN="${fields[4]}"
  REFRESH_TOKEN="${fields[5]}"
  EXPIRES_IN="${fields[6]}"
  TOKEN_OBTAINED_AT="${fields[7]}"
}

write_config() {
  local filter="$1"
  shift
  local tmp
  tmp="$(mktemp "${CONFIG_DIR}/config.XXXXXX")"
  jq "$@" "$filter" "$CONFIG_FILE" > "$tmp" || {
    rm -f "$tmp"
    die "无法更新配置：${CONFIG_FILE}"
  }
  chmod 600 "$tmp"
  mv -f "$tmp" "$CONFIG_FILE"
  load_config_fields
  validate_config
}

cmd_init() {
  [ "$#" -eq 0 ] || die "config init 不接受参数"
  local client_id client_secret my_assignee_id set_created_after created_after=""
  IFS= read -r -p 'client_id: ' client_id
  IFS= read -r -s -p 'client_secret: ' client_secret
  printf '\n' >&2
  IFS= read -r -p 'my_assignee_id: ' my_assignee_id
  [ -n "$client_id" ] || die "client_id 不能为空"
  [ -n "$client_secret" ] || die "client_secret 不能为空"
  [ -n "$my_assignee_id" ] || die "my_assignee_id 不能为空"
  IFS= read -r -p '是否设置全局 created_at 起点？[y/N]: ' set_created_after
  case "$set_created_after" in
    y|Y|yes|YES|是)
      IFS= read -r -p 'created_after（Unix 秒数）: ' created_after
      validate_timestamp "$created_after"
      ;;
  esac

  mkdir -p "$CONFIG_DIR"
  local tmp
  tmp="$(mktemp "${CONFIG_DIR}/config.XXXXXX")"
  jq -n \
    --arg client_id "$client_id" \
    --arg client_secret "$client_secret" \
    --arg my_assignee_id "$my_assignee_id" \
    --arg created_after "$created_after" '
      {
        client_id: $client_id,
        client_secret: $client_secret,
        my_assignee_id: $my_assignee_id,
        created_after: (if $created_after == "" then null else ($created_after | tonumber) end),
        access_token: null,
        refresh_token: null,
        expires_in: null,
        token_obtained_at: null,
        projects: [],
        projects_refreshed_at: null
      }
    ' > "$tmp"
  chmod 600 "$tmp"
  mv -f "$tmp" "$CONFIG_FILE"
  printf '配置已保存到 %s\n' "$CONFIG_FILE" >&2
}

cmd_config() {
  local subcommand="${1:-show}" converted timestamp
  [ "$#" -eq 0 ] || shift
  case "$subcommand" in
    path)
      [ "$#" -eq 0 ] || die "config path 不接受参数"
      printf '%s\n' "$CONFIG_FILE"
      ;;
    init) require_commands; cmd_init "$@" ;;
    show)
      [ "$#" -eq 0 ] || die "config show 不接受参数"
      require_commands
      validate_config
      jq '(.client_secret, .access_token, .refresh_token) |=
        (if . == null or . == "" then . else "***" end)' "$CONFIG_FILE"
      ;;
    set-created-after)
      [ "$#" -eq 1 ] || die "用法：pingcode-cli config set-created-after YYYY-MM-DD"
      [[ "$1" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || die "日期格式必须是 YYYY-MM-DD"
      require_commands
      command -v date >/dev/null 2>&1 || die "缺少依赖：date"
      validate_config
      converted="$(date -j -f '%Y-%m-%d %H:%M:%S' "$1 00:00:00" '+%s %Y-%m-%d' 2>/dev/null ||
        date -d "$1 00:00:00" '+%s %Y-%m-%d' 2>/dev/null)" || die "无效日期：$1"
      [ "${converted#* }" = "$1" ] || die "无效日期：$1"
      timestamp="${converted%% *}"
      validate_timestamp "$timestamp"
      write_config '.created_after = $timestamp' --argjson timestamp "$timestamp"
      printf 'created_after 已设置为 %s（%s，本机时区零点）\n' "$timestamp" "$1" >&2
      ;;
    *) die "未知 config 子命令：${subcommand}" ;;
  esac
}

HTTP_STATUS=""
HTTP_BODY=""

http_request() {
  local method="$1" url="$2"
  shift 2
  local raw
  raw="$(curl --silent --show-error --location \
    --connect-timeout 10 --max-time 60 \
    --request "$method" --write-out $'\n%{http_code}' \
    "$url" "$@")" || die "网络请求失败：${url}"
  HTTP_STATUS="${raw##*$'\n'}"
  HTTP_BODY="${raw%$'\n'*}"
  [[ "$HTTP_STATUS" =~ ^[0-9]{3}$ ]] || die "无法读取 HTTP 状态码"
}

save_tokens() {
  local response="$1" fallback_refresh="${2:-}" token_file
  token_file="$(mktemp "$RUNTIME_DIR/tokens.XXXXXX")"
  jq --arg fallback "$fallback_refresh" --argjson now "$EPOCHSECONDS" '
    select((.access_token | type == "string" and length > 0) and
      ((.expires_in | type) == "number" and .expires_in > 0 and .expires_in == (.expires_in | floor))) |
    (.refresh_token // "" | if . == "" then $fallback else . end) as $refresh |
    select($refresh | type == "string" and length > 0) |
    {access_token, refresh_token: $refresh, expires_in, token_obtained_at: $now}
  ' <<< "$response" > "$token_file" || return 1
  [ -s "$token_file" ] || return 1
  write_config '. + $tokens[0]' --slurpfile tokens "$token_file"
}

request_tokens() {
  local grant_type="$1" value="$2" fallback_refresh="${3:-}"
  local client_id client_secret
  client_id="$CLIENT_ID"
  client_secret="$CLIENT_SECRET"

  if [ "$grant_type" = "authorization_code" ]; then
    http_request GET "${API_BASE}/v1/auth/token" --get \
      --data-urlencode 'grant_type=authorization_code' \
      --data-urlencode "client_id=${client_id}" \
      --data-urlencode "client_secret=${client_secret}" \
      --data-urlencode "code=${value}"
  else
    http_request GET "${API_BASE}/v1/auth/token" --get \
      --data-urlencode 'grant_type=refresh_token' \
      --data-urlencode "refresh_token=${value}"
  fi

  [ "$HTTP_STATUS" -ge 200 ] && [ "$HTTP_STATUS" -lt 300 ] || return 1
  save_tokens "$HTTP_BODY" "$fallback_refresh"
}

clear_tokens() {
  write_config '
    .access_token = null |
    .refresh_token = null |
    .expires_in = null |
    .token_obtained_at = null
  '
}

token_is_valid() {
  [[ "$EXPIRES_IN" =~ ^[0-9]+$ && "$TOKEN_OBTAINED_AT" =~ ^[0-9]+$ ]] || return 1
  [ -n "$ACCESS_TOKEN" ] && (( TOKEN_OBTAINED_AT + EXPIRES_IN > EPOCHSECONDS + 60 ))
}

authorize_with_code() {
  local client_id encoded_client_id code
  client_id="$CLIENT_ID"
  encoded_client_id="$(jq -nr --arg value "$client_id" '$value | @uri')"
  printf '请手动打开以下地址完成授权：\n%s\n' \
    "https://open.pingcode.com/oauth2/authorize?response_type=code&client_id=${encoded_client_id}" >&2
  IFS= read -r -p 'code: ' code
  [ -n "$code" ] || die "code 不能为空"
  request_tokens authorization_code "$code" ||
    die "获取令牌失败（HTTP ${HTTP_STATUS}）：${HTTP_BODY}"
  printf '鉴权成功，令牌已保存。\n' >&2
}

try_refresh_token() {
  local refresh_token
  refresh_token="$REFRESH_TOKEN"
  [ -n "$refresh_token" ] || return 1
  printf 'access_token 已过期，正在刷新...\n' >&2
  if request_tokens refresh_token "$refresh_token" "$refresh_token"; then
    printf '令牌已刷新。\n' >&2
    return 0
  fi
  case "$HTTP_STATUS" in
    400|401) ;;
    *) die "刷新令牌失败（HTTP ${HTTP_STATUS}）：${HTTP_BODY}" ;;
  esac
  printf 'refresh_token 已失效，需要重新授权。\n' >&2
  return 1
}

renew_token() {
  if try_refresh_token; then
    return
  fi
  clear_tokens
  authorize_with_code
}

ensure_token() {
  validate_config
  token_is_valid || renew_token
}

cmd_auth() {
  [ "$#" -eq 0 ] || die "auth 不接受参数"
  validate_config
  if token_is_valid; then
    printf 'access_token 仍然有效。\n' >&2
    return
  fi
  renew_token
}

api_request() {
  local method="$1" endpoint="$2"
  shift 2
  ensure_token
  local token
  token="$ACCESS_TOKEN"
  http_request "$method" "${API_BASE}${endpoint}" \
    -H 'Accept: application/json' \
    -H "Authorization: Bearer ${token}" "$@"

  if [ "$HTTP_STATUS" = "401" ]; then
    renew_token
    token="$ACCESS_TOKEN"
    http_request "$method" "${API_BASE}${endpoint}" \
      -H 'Accept: application/json' \
      -H "Authorization: Bearer ${token}" "$@"
  fi
  [ "$HTTP_STATUS" -ge 200 ] && [ "$HTTP_STATUS" -lt 300 ] ||
    die "PingCode API 请求失败（HTTP ${HTTP_STATUS}）：${HTTP_BODY}"
  printf '%s\n' "$HTTP_BODY"
}

fetch_paginated() {
  local endpoint="$1" kind="$2" label="$3"
  shift 3
  local page=0 previous_count=-1 total page_count id count=0
  local response_file metadata_file items_file
  local -A seen=()
  response_file="$(mktemp "$RUNTIME_DIR/response.XXXXXX")"
  metadata_file="$(mktemp "$RUNTIME_DIR/metadata.XXXXXX")"
  items_file="$(mktemp "$RUNTIME_DIR/items.XXXXXX")"
  while :; do
    api_request GET "$endpoint" --get "$@" \
      --data-urlencode "page_index=${page}" --data-urlencode 'page_size=100' > "$response_file"
    jq -r --arg kind "$kind" '
      if (.values | type) != "array" then error("响应缺少 values 数组") else . end |
      (.total // (.values | length)) as $total |
      if ($total | type) == "number" and $total >= 0 and $total == ($total | floor)
      then . else error("响应的 total 无效") end |
      ([$total, (.values | length)] | @tsv),
      (.values[] | select($kind != "projects" or
        ((.id | type) == "string" and (.name | type) == "string")) | .id | tojson)
    ' "$response_file" > "$metadata_file" || die "${label}响应无效"
    {
      IFS=$'\t' read -r total page_count
      while IFS= read -r id; do
        if [[ ${seen["$id"]+present} != present ]]; then
          seen["$id"]=1
          count=$((count + 1))
        fi
      done
    } < "$metadata_file"
    jq -c --arg kind "$kind" '.values[] | select($kind != "projects" or
      ((.id | type) == "string" and (.name | type) == "string"))' "$response_file" >> "$items_file"
    (( count >= total )) && break
    (( page_count > 0 && count > previous_count )) || die "${label}分页没有前进，已停止请求"
    previous_count="$count"
    page=$((page + 1))
  done
  jq -s 'unique_by(.id)' "$items_file"
}

fetch_projects() {
  fetch_paginated '/v1/project/projects' projects 项目列表
}

cmd_projects_refresh() {
  validate_config
  local projects_file
  projects_file="$(mktemp "$RUNTIME_DIR/projects.XXXXXX")"
  fetch_projects | jq '[.[] | {id, name}]' > "$projects_file"

  write_config '.projects = $projects[0] | .projects_refreshed_at = $refreshed_at' \
    --slurpfile projects "$projects_file" --argjson refreshed_at "$EPOCHSECONDS"
  printf '已缓存 %s 个项目。\n' "$(jq 'length' "$projects_file")" >&2
}

projects_cache_is_valid() {
  jq -e '
    ((.projects_refreshed_at | type) == "number") and
    (.projects | type == "array") and
    all(.projects[];
      (.id | type == "string" and length > 0) and
      (.name | type == "string" and length > 0)
    )
  ' "$CONFIG_FILE" >/dev/null 2>&1
}

ensure_projects() {
  validate_config
  if ! projects_cache_is_valid; then
    printf '项目缓存不存在或不完整，正在获取...\n' >&2
    cmd_projects_refresh
  fi
}

cmd_projects() {
  [ "$#" -le 1 ] || die "用法：pingcode-cli projects [refresh]"
  local subcommand="${1:-}"
  case "$subcommand" in
    "") ensure_projects ;;
    refresh) cmd_projects_refresh ;;
    *) die "未知 projects 子命令：${subcommand}" ;;
  esac
  jq '[.projects[] | {id, name}]' "$CONFIG_FILE"
}

resolve_project() {
  local name="$1" matches count
  ensure_projects
  matches="$(jq --arg name "$name" '[.projects[] | select(.name == $name)]' "$CONFIG_FILE")"
  count="$(jq 'length' <<< "$matches")"
  [ "$count" -gt 0 ] || die "找不到项目：${name}。请运行 pingcode-cli projects 查看缓存"
  [ "$count" -eq 1 ] || die "存在多个同名项目：${name}"
  jq -c '.[0]' <<< "$matches"
}

resolve_state_id() {
  local state
  for state in "${BUG_STATES[@]}"; do
    if [ "${state%%:*}" = "$1" ]; then
      printf '%s\n' "${state#*:}"
      return
    fi
  done
  die "不支持的状态：$1。使用 pingcode-cli set-state --help 查看可选状态"
}

fetch_work_items() {
  local project_id="$1" state_id="$2" assignee_id="$3"
  local -a project_filter=()
  [ -z "$project_id" ] || project_filter=(--data-urlencode "project_id=${project_id}")
  fetch_paginated '/v1/project/work_items' work_items 工作项列表 \
    "${project_filter[@]}" \
    --data-urlencode "assignee_id=${assignee_id}" \
    --data-urlencode "state_id=${state_id}" \
    --data-urlencode 'type_id=bug' \
    --data-urlencode 'include_public_image_token=description'
}

add_image_access_tokens() {
  jq '
    def add_image_access_token:
      (.public_image_token // "") as $token |
      .description = (
        (.description // "") |
        if ($token | type) == "string" and ($token | length) > 0 then
          gsub(
            "(?i)(?<prefix><img[^>]*[[:space:]]src[[:space:]]*=[[:space:]]*[\"\u0027])(?<src>[^\"\u0027>]+)";
            if (.src | test("[?&]access_token=")) then
              "\(.prefix)\(.src)"
            else
              "\(.prefix)\(.src)\(if (.src | contains("?")) then "&" else "?" end)access_token=\($token)"
            end
          )
        else . end
      );
    if type == "array" then map(add_image_access_token) else add_image_access_token end
  '
}

shape_bugs() {
  local cutoff="$1"
  jq --arg cutoff "$cutoff" '
    ($cutoff | if . == "null" then null else tonumber end) as $created_after |
    [.[] |
      select(.is_archived != 1 and .is_deleted != 1) |
      select($created_after == null or (.created_at // 0) > $created_after)]
  ' | add_image_access_tokens | jq '
    [
      .[] |
      {
        id: (.id // ""),
        identifier: (.identifier // ""),
        title: (.title // ""),
        html_url: (.html_url // ""),
        state: (.state.name // ""),
        project: (.project.name // ""),
        assignee: (.assignee.display_name // ""),
        created_by: (.created_by.display_name // ""),
        description: (.description // "")
      }
    ] | sort_by(.identifier)
  '
}

shape_bug() {
  jq -e '[.]' | shape_bugs null | jq '.[0] // null'
}

cmd_bugs() {
  local project_name="" cutoff="" project_id="" state_name batches_file
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --project)
        need_arg "$1" "${2:-}"
        project_name="$2"
        shift 2
        ;;
      --project=*)
        project_name="${1#*=}"
        [ -n "$project_name" ] || die "--project 需要参数"
        shift
        ;;
      --created-after)
        need_arg "$1" "${2:-}"
        cutoff="$2"
        shift 2
        ;;
      --created-after=*)
        cutoff="${1#*=}"
        [ -n "$cutoff" ] || die "--created-after 需要参数"
        shift
        ;;
      *) die "未知 bugs 选项：$1" ;;
    esac
  done
  [ -z "$cutoff" ] || validate_timestamp "$cutoff"

  validate_config
  if [ -n "$project_name" ]; then
    project_id="$(resolve_project "$project_name" | jq -r '.id')"
  fi

  batches_file="$(mktemp "$RUNTIME_DIR/batches.XXXXXX")"
  for state_name in 新提交 重新打开; do
    fetch_work_items "$project_id" "$(resolve_state_id "$state_name")" "$MY_ASSIGNEE_ID" >> "$batches_file"
  done

  if [ -z "$cutoff" ]; then
    cutoff="$CREATED_AFTER"
  fi
  [ "$cutoff" = "null" ] || cutoff="${cutoff:-null}"
  jq -s 'add // [] | unique_by(.id)' "$batches_file" | shape_bugs "$cutoff"
}

get_bug() {
  [[ "$1" =~ ^[A-Za-z0-9_-]+$ ]] || die "无效的 bug id：$1"
  api_request GET "/v1/project/work_items/$1" --get \
    --data-urlencode 'include_public_image_token=description'
}

cmd_bug() {
  [ "$#" -eq 1 ] || die "用法：pingcode-cli bug <bug_id>"
  local bug_file comments_file
  bug_file="$(mktemp "$RUNTIME_DIR/bug.XXXXXX")"
  comments_file="$(mktemp "$RUNTIME_DIR/comments.XXXXXX")"
  get_bug "$1" | shape_bug > "$bug_file"
  if [ "$(<"$bug_file")" = null ]; then
    printf 'null\n'
    return
  fi
  cmd_comments "$1" > "$comments_file"
  jq --slurpfile comments "$comments_file" '. + {comments: $comments[0]}' "$bug_file"
}

cmd_comments() {
  [ "$#" -eq 1 ] || die "用法：pingcode-cli comments <bug_id>"
  [[ "$1" =~ ^[A-Za-z0-9_-]+$ ]] || die "无效的 bug id：$1"
  # ponytail: 只取第一页；评论超过一页时再接入 fetch_paginated。
  api_request GET '/v1/comments' --get \
    --data-urlencode 'principal_type=workitem' --data-urlencode "principal_id=$1" \
    --data-urlencode 'page_index=0' --data-urlencode 'page_size=30' |
    jq -e 'if (.values | type) != "array" then error("评论响应缺少 values 数组") else . end |
      [.values[] | select(.is_deleted != 1) | {id, content, created_by: (.created_by.display_name // "")}]'
}

cmd_set_state() {
  [ "$#" -ge 1 ] || die "用法：pingcode-cli set-state <bug_id> [--state <状态名称>]"
  local bug_id="$1" state_name="" state_id response
  shift
  [[ "$bug_id" =~ ^[A-Za-z0-9_-]+$ ]] || die "无效的 bug id：$bug_id"
  while [ "$#" -gt 0 ]; do
    [ -z "$state_name" ] || die "--state 只能指定一次"
    case "$1" in
      --state)
        need_arg "$1" "${2:-}"
        state_name="$2"
        shift 2
        ;;
      --state=*)
        state_name="${1#*=}"
        [ -n "$state_name" ] || die "--state 需要参数"
        shift
        ;;
      *) die "未知 set-state 选项：$1" ;;
    esac
  done
  if [ -z "$state_name" ]; then
    local index choice
    for index in "${!BUG_STATES[@]}"; do
      printf '%d) %s\n' "$((index + 1))" "${BUG_STATES[index]%%:*}" >&2
    done
    while :; do
      printf '请选择状态编号（回车取消）: ' >&2
      IFS= read -r choice || die "未选择状态，已取消"
      case "$choice" in
        '') printf '已取消。\n' >&2; return ;;
        [1-7]) state_name="${BUG_STATES[choice - 1]%%:*}"; break ;;
        *) printf '请输入 1–7 之间的编号。\n' >&2 ;;
      esac
    done
  fi
  state_id="$(resolve_state_id "$state_name")"

  response="$(api_request PATCH "/v1/project/work_items/${bug_id}" \
    -H 'Content-Type: application/json' \
    --data "$(jq -cn --arg state_id "$state_id" '{state_id: $state_id}')")"
  shape_bug <<< "$response"
}

cmd_doctor() {
  [ "$#" -eq 0 ] || die "doctor 不接受参数"
  local command permission failed=0
  (( BASH_VERSINFO[0] >= 5 )) || die "需要 Bash 5.0+"
  printf 'OK: Bash %s\n' "$BASH_VERSION"
  for command in curl jq date stat; do
    if command -v "$command" >/dev/null 2>&1; then
      printf 'OK: %s\n' "$command"
    else
      printf 'FAIL: 缺少依赖 %s\n' "$command" >&2
      failed=1
    fi
  done
  [ "$failed" -eq 0 ] || return 1
  init_runtime
  printf '配置路径：%s\n' "$CONFIG_FILE"
  validate_config
  printf 'OK: 配置字段\n'
  permission="$(stat -c '%a' "$CONFIG_FILE" 2>/dev/null || stat -f '%Lp' "$CONFIG_FILE")"
  if [ "$permission" = 600 ]; then
    printf 'OK: 配置权限 600\n'
  else
    printf 'FAIL: 配置权限为 %s，应为 600\n' "$permission" >&2
    failed=1
  fi
  if projects_cache_is_valid; then
    printf 'OK: 项目缓存\n'
  else
    printf 'FAIL: 项目缓存不存在或不完整，请运行 pingcode-cli projects refresh\n' >&2
    failed=1
  fi
  if token_is_valid; then
    printf 'OK: access_token 本地有效期\n'
    if (
      http_request GET "${API_BASE}/v1/project/projects" --get \
        -H 'Accept: application/json' -H "Authorization: Bearer ${ACCESS_TOKEN}" \
        --data-urlencode 'page_index=0' --data-urlencode 'page_size=1'
      [ "$HTTP_STATUS" -ge 200 ] && [ "$HTTP_STATUS" -lt 300 ] ||
        die "API 检查失败（HTTP ${HTTP_STATUS}），请检查网络、权限或运行 pingcode-cli auth"
      jq -e '.values | type == "array"' <<< "$HTTP_BODY" >/dev/null
    ); then
      printf 'OK: API 连通性及项目读取权限\n'
    else
      printf 'FAIL: API 检查失败\n' >&2
      failed=1
    fi
  else
    printf 'FAIL: access_token 缺失或已过期，请运行 pingcode-cli auth\n' >&2
    failed=1
  fi
  [ "$failed" -eq 0 ]
}

usage() {
  cat <<'EOF'
pingcode-cli - 使用 PingCode 官方 API 管理 bug

用法：
  pingcode-cli config [show|path|init|set-created-after YYYY-MM-DD]
  pingcode-cli auth
  pingcode-cli doctor
  pingcode-cli projects [refresh]
  pingcode-cli bugs [--project <项目名称>] [--created-after <Unix 秒数>]
  pingcode-cli bug <bug_id>
  pingcode-cli comments <bug_id>
  pingcode-cli set-state <bug_id> [--state <状态名称>]

命令：
  config      初始化、脱敏查看配置、显示路径或设置日期起点
  auth        获取、刷新或重新获取用户令牌
  doctor      检查依赖、配置、项目缓存、令牌和 API
  projects    查看项目缓存；refresh 重新获取项目
  bugs        获取分配给我的新提交和重新打开的 bug，默认全部项目
  bug         获取一个 bug，附带评论
  comments    获取一个 bug 的第一页未删除评论
  set-state   修改一个 bug 的状态
EOF
}

usage_config() {
  cat <<'EOF'
pingcode-cli config - 管理配置

用法：
  pingcode-cli config init
  pingcode-cli config show
  pingcode-cli config path
  pingcode-cli config set-created-after YYYY-MM-DD

交互内容：
  client_id、client_secret、my_assignee_id
  是否设置全局 created_at 起点（Unix 秒数）

不传子命令时等同于 show；client_secret、access_token 和 refresh_token 脱敏展示。
set-created-after 只接受 YYYY-MM-DD，按本机时区零点转换为 Unix 秒数并保存。

配置文件：
  ~/.config/pingcode-cli/config.json
  设置 XDG_CONFIG_HOME 时使用 $XDG_CONFIG_HOME/pingcode-cli/config.json
EOF
}

usage_doctor() {
  cat <<'EOF'
pingcode-cli doctor - 检查运行环境

用法：
  pingcode-cli doctor

检查 Bash、curl、jq、date、stat、配置字段和权限、项目缓存、令牌有效期，
并通过只读项目请求检查 API 连通性与权限。失败时返回非零退出码。
不修改配置、不刷新令牌、不触发交互授权。
EOF
}

usage_auth() {
  cat <<'EOF'
pingcode-cli auth - 获取或刷新用户令牌

用法：
  pingcode-cli auth

access_token 有效时直接返回；过期时尝试 refresh_token。
refresh_token 不可用时输出授权地址，并等待输入 code。
EOF
}

usage_projects() {
  cat <<'EOF'
pingcode-cli projects - 管理项目缓存

用法：
  pingcode-cli projects
  pingcode-cli projects refresh

子命令：
  refresh  重新获取全部项目，仅缓存 id 和 name

不传子命令时输出缓存；缓存不存在或不完整时自动获取。
EOF
}

usage_bugs() {
  cat <<'EOF'
pingcode-cli bugs - 获取分配给我的 bug

用法：
  pingcode-cli bugs [选项]

选项：
  --project <项目名称>       省略时直接跨项目查询，不读取项目缓存
  --created-after <Unix 秒数>  覆盖配置中的全局时间戳
  -h, --help                 显示帮助

固定查询新提交和重新打开，过滤已归档或已删除的 bug；列表不请求评论。
EOF
}

usage_bug() {
  cat <<'EOF'
pingcode-cli bug - 获取一个 bug

用法：
  pingcode-cli bug <bug_id>

参数：
  bug_id  PingCode API 返回的工作项 id

附带 comments 数组；已归档或已删除的 bug 返回 null。
EOF
}

usage_comments() {
  cat <<'EOF'
pingcode-cli comments - 获取 bug 评论

用法：
  pingcode-cli comments <bug_id>

只请求第一页（最多 30 条），过滤 is_deleted = 1 的评论。
输出数组，每条仅含 id、content、created_by（display_name）。
EOF
}

usage_set_state() {
  cat <<'EOF'
pingcode-cli set-state - 修改 bug 状态

用法：
  pingcode-cli set-state <bug_id>
  pingcode-cli set-state <bug_id> --state <状态名称>

省略 --state 时每行显示一个状态，输入编号后提交；直接回车或按 Ctrl-D 取消。
可选状态：已拒绝、重新打开、已修复、新提交、挂起、已发布、处理中。
状态 ID 固定在代码中，直接发送更新请求，不查询项目、bug 详情或状态列表。
EOF
}

is_help() {
  local arg
  for arg in "$@"; do
    case "$arg" in -h|--help) return 0 ;; esac
  done
  return 1
}

case "${1:-}" in
  -h|--help|"") usage ;;
  config)
    shift
    is_help "$@" && { usage_config; exit 0; }
    cmd_config "$@"
    ;;
  doctor)
    shift
    is_help "$@" && { usage_doctor; exit 0; }
    cmd_doctor "$@"
    ;;
  auth)
    shift
    is_help "$@" && { usage_auth; exit 0; }
    require_commands
    validate_config
    cmd_auth "$@"
    ;;
  projects)
    shift
    is_help "$@" && { usage_projects; exit 0; }
    require_commands
    validate_config
    cmd_projects "$@"
    ;;
  bugs)
    shift
    is_help "$@" && { usage_bugs; exit 0; }
    require_commands
    validate_config
    cmd_bugs "$@"
    ;;
  bug)
    shift
    is_help "$@" && { usage_bug; exit 0; }
    require_commands
    validate_config
    cmd_bug "$@"
    ;;
  comments)
    shift
    is_help "$@" && { usage_comments; exit 0; }
    require_commands
    validate_config
    cmd_comments "$@"
    ;;
  set-state)
    shift
    is_help "$@" && { usage_set_state; exit 0; }
    require_commands
    validate_config
    cmd_set_state "$@"
    ;;
  *) die "未知命令：$1。使用 pingcode-cli --help 查看帮助" ;;
esac
