#compdef pingcode-cli

_pingcode_config_file() {
  print -r -- "${XDG_CONFIG_HOME:-${HOME}/.config}/pingcode-cli/config.json"
}

_pingcode_projects() {
  local file
  file="$(_pingcode_config_file)"
  [[ -r "$file" ]] && jq -r '.projects[]?.name' "$file" 2>/dev/null
}

_pingcode_complete_projects() {
  local -a projects
  projects=("${(@f)$(_pingcode_projects)}")
  compadd -a projects
}

_pingcode-cli() {
  local command="$words[2]"
  local -a commands
  commands=(
    'config:管理配置'
    'auth:获取或刷新用户令牌'
    'doctor:检查运行环境与 API'
    'projects:查看或刷新项目缓存'
    'bugs:获取 bug 列表'
    'bug:获取一个 bug'
    'comments:获取 bug 评论'
    'set-state:修改 bug 状态'
  )

  if (( CURRENT == 2 )); then
    _describe -t commands '命令' commands
    return
  fi

  shift words
  (( CURRENT-- ))
  case "$command" in
    config)
      _arguments '(-h --help)'{-h,--help}'[显示帮助]' \
        '1:子命令:(init show path set-created-after)' '2:日期（YYYY-MM-DD）:'
      ;;
    auth|doctor)
      _arguments '(-h --help)'{-h,--help}'[显示帮助]'
      ;;
    projects)
      _arguments '(-h --help)'{-h,--help}'[显示帮助]' '1:子命令:(refresh)'
      ;;
    bugs)
      _arguments \
        '(-h --help)'{-h,--help}'[显示帮助]' \
        '--project[项目名称]:项目名称:_pingcode_complete_projects' \
        '--created-after[覆盖全局 created_at 起点]:Unix 秒数:'
      ;;
    bug|comments)
      _arguments '(-h --help)'{-h,--help}'[显示帮助]' '1:bug id:'
      ;;
    set-state)
      _arguments '(-h --help)'{-h,--help}'[显示帮助]' '1:bug id:' \
        '--state[目标状态，省略时交互选择]:状态名称:(已拒绝 重新打开 已修复 新提交 挂起 已发布 处理中)'
      ;;
  esac
}

_pingcode-cli "$@"
