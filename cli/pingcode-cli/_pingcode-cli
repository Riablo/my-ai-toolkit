#compdef pingcode-cli

_pingcode-cli() {
  local -a commands config_commands states
  commands=(
    'bugs:列出我的未解决缺陷'
    'set-state:修改缺陷状态'
    'config:管理配置'
  )
  config_commands=(
    'show:查看当前配置'
    'init:初始化配置'
    'edit:编辑配置文件'
    'path:显示配置文件路径'
    'check:检查配置是否可用'
  )
  states=(待处理 处理中 已修复 重新打开 挂起)

  if (( CURRENT == 2 )); then
    if [[ "$PREFIX" == -* ]]; then
      _arguments '(-h --help)'{-h,--help}'[显示帮助信息]'
    else
      _describe -t commands 'command' commands
    fi
    return
  fi

  case "$words[2]" in
    bugs)
      _arguments \
        '--debug[打印原始 API 响应]' \
        '--json[以 JSON 格式输出缺陷列表]' \
        '1:limit:'
      ;;
    set-state)
      _arguments \
        '1:bug id:' \
        '2:state:($states)'
      ;;
    config)
      if (( CURRENT == 3 )); then
        _describe -t config-commands 'config command' config_commands
      fi
      ;;
  esac
}

_pingcode-cli "$@"
