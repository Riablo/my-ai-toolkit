#compdef pingcode-cli

_pingcode_config_file() {
  print -r -- "${XDG_CONFIG_HOME:-${HOME}/.config}/pingcode-cli/config.json"
}

_pingcode_projects() {
  local file
  file="$(_pingcode_config_file)"
  [[ -r "$file" ]] && jq -r '.projects[]?.name' "$file" 2>/dev/null
}

_pingcode_states() {
  local file project="" index
  file="$(_pingcode_config_file)"
  for (( index = 3; index <= ${#words}; index++ )); do
    case "${words[index]}" in
      --project)
        project="${words[index + 1]:-}"
        ;;
      --project=*)
        project="${words[index]#*=}"
        ;;
    esac
  done
  if [[ -r "$file" && -n "$project" ]]; then
    jq -r --arg project "$project" '[.projects[]? | select(.name == $project) | .states[]?.name] | unique[]' "$file" 2>/dev/null
  elif [[ -r "$file" ]]; then
    jq -r '[.projects[]?.states[]?.name] | unique[]' "$file" 2>/dev/null
  fi
}

_pingcode-cli() {
  local command="$words[2]"
  local -a commands projects states
  commands=(
    'init:初始化配置'
    'auth:获取或刷新用户令牌'
    'projects:查看或刷新项目缓存'
    'bugs:获取 bug 列表'
    'bug:获取一个 bug'
    'set-state:修改 bug 状态'
  )
  projects=("${(@f)$(_pingcode_projects)}")
  states=("${(@f)$(_pingcode_states)}")

  if (( CURRENT == 2 )); then
    _describe -t commands '命令' commands
    return
  fi

  shift words
  (( CURRENT-- ))
  case "$command" in
    init|auth)
      _arguments '(-h --help)'{-h,--help}'[显示帮助]'
      ;;
    projects)
      _arguments '(-h --help)'{-h,--help}'[显示帮助]' '1:子命令:(refresh)'
      ;;
    bugs)
      _arguments \
        '(-h --help)'{-h,--help}'[显示帮助]' \
        '--project[项目名称]:项目名称:($projects)' \
        '*--state[状态名称，可重复]:状态名称:($states)' \
        '--created-after[覆盖全局 created_at 起点]:Unix 秒数:'
      ;;
    bug)
      _arguments '(-h --help)'{-h,--help}'[显示帮助]' '1:bug id:'
      ;;
    set-state)
      _arguments '(-h --help)'{-h,--help}'[显示帮助]' '1:bug id:' '2:状态名称:($states)'
      ;;
  esac
}

_pingcode-cli "$@"
