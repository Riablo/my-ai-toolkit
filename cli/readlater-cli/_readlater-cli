#compdef readlater-cli

_readlater-cli() {
  local -a commands common_options
  commands=('fetch:抓取一个链接摘要')
  common_options=(
    '(-j --json)'{-j,--json}'[输出 JSON]'
    '--timeout[请求超时时间（秒）]:seconds:'
    '--summary-length[概要最大长度]:length:'
  )

  if (( CURRENT == 2 )); then
    if [[ "$PREFIX" == -* ]]; then
      _arguments \
        '(-h --help)'{-h,--help}'[显示帮助信息]' \
        $common_options
    elif [[ "$PREFIX" == http://* || "$PREFIX" == https://* ]]; then
      _urls
    else
      _describe -t commands 'command' commands
      _urls
    fi
    return
  fi

  case "$words[2]" in
    fetch)
      _arguments \
        $common_options \
        '1:url:_urls'
      ;;
  esac
}

_readlater-cli "$@"
